+ 			ret = ppe_l3_if_set(ft->ppe_dev, nh.l3_if,
+ 					    data.eth.src, odev->mtu, -1);
+@@ -1242,6 +1494,8 @@ err_my_mac:
+ 	ppe_ft_my_mac_put(ft, flow->my_mac);
+ err_pppoe:
+ 	ppe_ft_pppoe_put(ft, flow->pppoe);
++err_vlan:
++	ppe_ft_vlan_put(ft, flow->vlan);
+ err_pub_ip:
+ 	ppe_ft_pub_ip_put(ft, flow->pub_ip);
+ err_unlock:
+@@ -1272,6 +1526,7 @@ static int ppe_ft_flow_destroy(struct pp
+ 		clear_bit(flow->nexthop, ft->nexthop_used);
+ 		ppe_ft_my_mac_put(ft, flow->my_mac);
+ 		ppe_ft_pppoe_put(ft, flow->pppoe);
++		ppe_ft_vlan_put(ft, flow->vlan);
+ 		ppe_ft_pub_ip_put(ft, flow->pub_ip);
+ 	} else {
+ 		ppe_ft_flow_quarantine(ft, flow);
+@@ -2113,7 +2368,7 @@ int ppe_flowtable_setup(struct ppe_devic
+ 		return -ENOMEM;
+ 
+ 	ft->ppe_dev = ppe_dev;
+-	if (WARN_ON(ppe_ft_pppoe_l3_if(ft, PPE_FT_PPPOE_SESSIONS) >
++	if (WARN_ON(ppe_ft_vlan_l3_if(ft, PPE_L3_VLAN_UPLINKS) >
+ 		    PPE_IN_L3_IF_TBL_ENTRIES)) {
+ 		kfree(ft);
+ 		return -ERANGE;
+@@ -2188,6 +2443,7 @@ void ppe_flowtable_destroy(struct ppe_de
+ 			continue;
+ 		if (ft->pppoe[i].connected)
+ 			ppe_pppoe_session_set(ft->ppe_dev, i, false, 0, NULL, 0);
++		ppe_ft_vlan_put(ft, ft->pppoe[i].vlan);
+ 		memset(&ft->pppoe[i], 0, sizeof(ft->pppoe[i]));
+ 	}
