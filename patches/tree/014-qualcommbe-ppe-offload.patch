diff --git a/target/linux/qualcommbe/patches-6.18/0514-06-net-ethernet-qualcomm-ppe-offload-ds-lite-flows.patch b/target/linux/qualcommbe/patches-6.18/0514-06-net-ethernet-qualcomm-ppe-offload-ds-lite-flows.patch
