diff --git a/target/linux/qualcommbe/patches-6.18/0514-01-net-ethernet-qualcomm-ppe-recognize-tunnel-flow-rules.patch b/target/linux/qualcommbe/patches-6.18/0514-01-net-ethernet-qualcomm-ppe-recognize-tunnel-flow-rules.patch
new file mode 100644
index 0000000000..ce0de59bbf
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0514-01-net-ethernet-qualcomm-ppe-recognize-tunnel-flow-rules.patch
@@ -0,0 +1,133 @@
+From: Kenneth Kasilag <kenneth@kasilag.me>
+Date: Sun, 05 Jul 2026 00:00:00 +0000
+Subject: [PATCH] net: ethernet: qualcomm: ppe: recognize tunnel flow rules
+
+Recognize both lightweight-route tunnel metadata and the ip6tnl
+redirect/META forms used by DS-Lite and MAP-E. Dispatch them to a dedicated
+handler which remains fail-closed until the shared tunnel lifecycle exists.
+
+This prevents an encapsulated route from falling through to the ordinary L3
+translator and makes the Linux rule contract independently reviewable from
+the hardware transaction implementation. HPPE continues to reject the
+APPE-only path.
+
+Behavior is unchanged: tunnel rules were already rejected by key, action or
+redirect-device validation.
+
+Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+@@ -29,6 +29,7 @@
+ #include <linux/rtnetlink.h>
+ #include <linux/seq_file.h>
+ #include <net/flow_offload.h>
++#include <net/ip6_tunnel.h>
+ #include <net/ipv6.h>
+ #include <net/tcp.h>
+ 
+@@ -909,6 +910,94 @@ static void ppe_ft_vlan_put(struct ppe_f
+ 	memset(slot, 0, sizeof(*slot));
+ }
+ 
++/* Lightweight-route tunnels expose their endpoints as ENC_* keys and
++ * TUNNEL_{ENCAP,DECAP} actions. DS-Lite and MAP-E instead redirect to an
++ * ordinary ip6tnl netdevice; its fixed endpoints or FMR list live in the
++ * netdevice's struct ip6_tnl and never appear as ENC_* keys.
++ */
++#define PPE_FT_TUNNEL_KEYS	(BIT_ULL(FLOW_DISSECTOR_KEY_ENC_CONTROL) | \
++				 BIT_ULL(FLOW_DISSECTOR_KEY_ENC_KEYID) | \
++				 BIT_ULL(FLOW_DISSECTOR_KEY_ENC_IPV4_ADDRS) | \
++				 BIT_ULL(FLOW_DISSECTOR_KEY_ENC_IPV6_ADDRS))
++
++static bool ppe_ft_ipip6_dev(const struct net_device *dev)
++{
++	const struct ip6_tnl *tunnel;
++
++	if (!dev || !dev->rtnl_link_ops || !dev->rtnl_link_ops->kind ||
++	    strcmp(dev->rtnl_link_ops->kind, "ip6tnl"))
++		return false;
++
++	tunnel = netdev_priv(dev);
++
++	return tunnel->parms.proto == IPPROTO_IPIP;
++}
++
++static bool ppe_ft_rule_is_tunnel(const struct flow_rule *rule)
++{
++	const struct flow_action_entry *act;
++	const struct net_device *odev = NULL;
++	struct net_device *idev;
++	struct flow_match_meta meta;
++	bool is_tunnel;
++	int i;
++
++	if (rule->match.dissector->used_keys & PPE_FT_TUNNEL_KEYS)
++		return true;
++
++	flow_action_for_each(i, act, &rule->action) {
++		switch (act->id) {
++		case FLOW_ACTION_TUNNEL_ENCAP:
++		case FLOW_ACTION_TUNNEL_DECAP:
++			return true;
++		case FLOW_ACTION_REDIRECT:
++			if (ppe_ft_ipip6_dev(act->dev))
++				return true;
++			odev = act->dev;
++			break;
++		default:
++			break;
++		}
++	}
++
++	/* The decapsulation rule redirects to the inner destination. Its only
++	 * tunnel identity is the ip6tnl ingress ifindex in the META key.
++	 */
++	if (!odev ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META))
++		return false;
++
++	flow_rule_match_meta(rule, &meta);
++	if (meta.mask->ingress_ifindex != -1)
++		return false;
++
++	idev = dev_get_by_index(dev_net(odev), meta.key->ingress_ifindex);
++	if (!idev)
++		return false;
++
++	is_tunnel = ppe_ft_ipip6_dev(idev);
++	dev_put(idev);
++
++	return is_tunnel;
++}
++
++/* Tunneled flows stay on the software path for now. The SoC carries a
++ * tunnel engine that could take them: the tunnel lookup block (which
++ * already hosts the PPPoE session table) terminates encapsulations
++ * into tunnel L3 interfaces, and the tunnel fields of the egress L3
++ * interfaces generate them. A fixed IPIP6 implementation must derive
++ * its endpoints from the redirect netdevice and program a shared
++ * tunnel-port lifecycle before publishing either direction.
++ */
++static int ppe_ft_tunnel_replace(struct ppe_flowtable *ft,
++				 struct flow_cls_offload *f)
++{
++	if (!ft->ppe_dev->variant->has_tunnel_engine)
++		return -EOPNOTSUPP;
++
++	return -EOPNOTSUPP;	/* TODO: program the tunnel engine */
++}
++
+ /* Hash key of a flow's source IP for the host refcount table. */
+ static u32 ppe_ft_host_key(const struct ppe_flow_entry *flow)
+ {
+@@ -1052,6 +1141,9 @@ static int ppe_ft_flow_replace(struct pp
+ 	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV6_ADDRS))
+ 		return -EOPNOTSUPP;
+ 
++	if (ppe_ft_rule_is_tunnel(rule))
++		return ppe_ft_tunnel_replace(ft, f);
++
+ 	if (rule->match.dissector->used_keys &
+ 	    ~(BIT_ULL(FLOW_DISSECTOR_KEY_META) |
+ 	      BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) |
diff --git a/target/linux/qualcommbe/patches-6.18/0514-02-net-ethernet-qualcomm-ppe-add-tunnel-decap-transactions.patch b/target/linux/qualcommbe/patches-6.18/0514-02-net-ethernet-qualcomm-ppe-add-tunnel-decap-transactions.patch
new file mode 100644
index 0000000000..acb492e12b
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0514-02-net-ethernet-qualcomm-ppe-add-tunnel-decap-transactions.patch
@@ -0,0 +1,311 @@
+From: Kenneth Kasilag <kenneth@kasilag.me>
+Date: Sun, 05 Jul 2026 00:00:00 +0000
+Subject: [PATCH] net: ethernet: qualcomm: ppe: add tunnel decap transactions
+
+Add the serialized APPE tunnel lookup-table transaction used by tunnel
+termination. The working vendor driver writes a 14-word operand and commits
+it through TL_TBL_OP, then uses a separate get command and result block.
+
+Require post-add readback and return the selected index before a readback
+failure so the caller can remove or quarantine a row whose add succeeded.
+Return -ETIMEDOUT when the command remains busy after 64 reads instead of
+copying the vendor helper's stuck-busy success bug. Indexed deletion clears
+the associated counter only after the hardware removes the row.
+
+Add the device-level mutex here because the operand and command registers
+are shared by every later tunnel transaction.
+
+Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/Makefile
++++ b/drivers/net/ethernet/qualcomm/ppe/Makefile
+@@ -5,6 +5,7 @@
+ 
+ obj-$(CONFIG_QCOM_PPE) += qcom-ppe.o
+ qcom-ppe-objs := ppe.o ppe_config.o ppe_debugfs.o ppe_port.o ppe_api.o ppe_bridge.o ppe_flow.o ppe_flowtable.o
++qcom-ppe-objs += ppe_tunnel.o
+ 
+ #EDMA
+ qcom-ppe-objs += edma.o edma_cfg_rx.o edma_cfg_tx.o edma_debugfs.o edma_port.o edma_rx.o edma_tx.o edma_ethtool.o
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe.c
+@@ -21,6 +21,7 @@
+ #include "ppe_config.h"
+ #include "ppe_debugfs.h"
+ #include "ppe_flow.h"
++#include "ppe_tunnel.h"
+ #include "ppe_flowtable.h"
+ #include "ppe_port.h"
+ 
+@@ -217,6 +218,9 @@ static int qcom_ppe_probe(struct platfor
+ 	ret = ppe_flow_hw_init(ppe_dev);
+ 	if (ret)
+ 		return dev_err_probe(dev, ret, "PPE flow engine init failed\n");
++	ret = ppe_tunnel_hw_init(ppe_dev);
++	if (ret)
++		return dev_err_probe(dev, ret, "PPE tunnel engine init failed\n");
+ 
+ 	ret = edma_setup(ppe_dev);
+ 	if (ret)
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe.h
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe.h
+@@ -70,6 +70,7 @@ struct ppe_variant {
+  * @fdb_cmd_id: Rolling command ID of the last issued FDB operation.
+  * @flow_lock: Lock to serialize the L3 flow operation registers.
+  * @flow_cmd_id: Rolling command ID of the last issued flow operation.
++ * @tunnel_lock: Lock serializing tunnel operands, commands and tables.
+  * @num_icc_paths: Number of interconnect paths.
+  * @icc_paths: Interconnect path array.
+  *
+@@ -93,6 +94,8 @@ struct ppe_device {
+ 	/* Serialize the L3 flow operation registers. */
+ 	struct mutex flow_lock;
+ 	u8 flow_cmd_id;
++	/* Serialize the APPE tunnel command and table registers. */
++	struct mutex tunnel_lock;
+ 	unsigned int num_icc_paths;
+ 	struct icc_bulk_data icc_paths[] __counted_by(num_icc_paths);
+ };
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+@@ -757,6 +757,31 @@
+ #define PPE_PPPOE_SESSION_EXT2_L3_IF		GENMASK(15, 8)
+ #define PPE_PPPOE_SESSION_EXT2_L3_IF_VALID	BIT(16)
+ 
++/* APPE tunnel lookup commands. Add/delete use one shared 14-word operand;
++ * get has a separate command, operand and result block. The backing table is
++ * not the insertion interface.
++ */
++#define PPE_TUNNEL_TBL_OP_ADDR			0x300000
++#define PPE_TUNNEL_TBL_OP_DATA_ADDR		0x300004
++#define PPE_TUNNEL_TBL_RD_OP_ADDR		0x300054
++#define PPE_TUNNEL_TBL_RD_OP_DATA_ADDR		0x300058
++#define PPE_TUNNEL_TBL_RD_RESULT_ADDR		0x3000a0
++#define PPE_TUNNEL_OP_TYPE			GENMASK(2, 0)
++#define PPE_TUNNEL_OP_HASH_BLOCK_BITMAP		GENMASK(4, 3)
++#define PPE_TUNNEL_OP_MODE			BIT(5)
++#define PPE_TUNNEL_OP_ENTRY_INDEX		GENMASK(12, 6)
++#define PPE_TUNNEL_OP_RESULT			BIT(13)
++#define PPE_TUNNEL_OP_BUSY			BIT(14)
++#define PPE_TUNNEL_OP_POLLS			64
++#define PPE_TUNNEL_ENTRIES			128
++
++/* Tunnel decap hit counters are in the ingress-policer block despite the
++ * TL name. Clear them only after an indexed delete succeeds.
++ */
++#define PPE_TUNNEL_COUNTER_ADDR			0x154000
++#define PPE_TUNNEL_COUNTER_INC			0x10
++#define PPE_TUNNEL_COUNTER_WORDS		3
++
+ /* Per-VSI L3 interface binding: routed packets classified into the VSI
+  * take this ingress L3 interface instead of the one bound to their
+  * ingress port.
+--- /dev/null
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_tunnel.c
+@@ -0,0 +1,176 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* Copyright (c) 2026 Kenneth Kasilag <kenneth@kasilag.me> */
++
++/* Low-level APPE tunnel termination transactions. The command operand and
++ * result blocks are shared hardware resources, so every operation is
++ * serialized by the device tunnel lock. Higher layers own IDs and compose
++ * these primitives into a refcounted lifecycle before publishing any flow.
++ */
++
++#include <linux/bitfield.h>
++#include <linux/device.h>
++#include <linux/errno.h>
++#include <linux/kernel.h>
++#include <linux/regmap.h>
++
++#include "ppe.h"
++#include "ppe_regs.h"
++#include "ppe_tunnel.h"
++
++enum ppe_tunnel_op {
++	PPE_TUNNEL_OP_ADD,
++	PPE_TUNNEL_OP_DEL,
++	PPE_TUNNEL_OP_GET,
++};
++
++static int ppe_tunnel_check(struct ppe_device *ppe_dev)
++{
++	if (!ppe_dev->variant->has_tunnel_engine)
++		return -EOPNOTSUPP;
++
++	return 0;
++}
++
++static int ppe_tunnel_op_wait(struct ppe_device *ppe_dev, u32 reg, u32 *value)
++{
++	int i, ret;
++	u32 val;
++
++	for (i = 0; i < PPE_TUNNEL_OP_POLLS; i++) {
++		ret = regmap_read(ppe_dev->regmap, reg, &val);
++		if (ret)
++			return ret;
++		if (!(val & PPE_TUNNEL_OP_BUSY)) {
++			*value = val;
++			return 0;
++		}
++		cpu_relax();
++	}
++
++	return -ETIMEDOUT;
++}
++
++static int ppe_tunnel_op_issue(struct ppe_device *ppe_dev, u32 reg,
++			       enum ppe_tunnel_op op, bool by_index,
++			       int *index)
++{
++	u32 val;
++	int ret;
++
++	val = FIELD_PREP(PPE_TUNNEL_OP_TYPE, op) |
++	      FIELD_PREP(PPE_TUNNEL_OP_HASH_BLOCK_BITMAP, 3) |
++	      PPE_TUNNEL_OP_BUSY;
++	if (by_index)
++		val |= PPE_TUNNEL_OP_MODE |
++		       FIELD_PREP(PPE_TUNNEL_OP_ENTRY_INDEX, *index);
++
++	ret = regmap_write(ppe_dev->regmap, reg, val);
++	if (ret)
++		return ret;
++	ret = ppe_tunnel_op_wait(ppe_dev, reg, &val);
++	if (ret)
++		return ret;
++	if (val & PPE_TUNNEL_OP_RESULT)
++		return op == PPE_TUNNEL_OP_ADD ? -ENOSPC : -ENOENT;
++
++	*index = FIELD_GET(PPE_TUNNEL_OP_ENTRY_INDEX, val);
++	return 0;
++}
++
++static int ppe_tunnel_decap_get_locked(struct ppe_device *ppe_dev, int index,
++				       struct ppe_tunnel_decap_entry *entry)
++{
++	int ret;
++
++	ret = ppe_tunnel_op_issue(ppe_dev, PPE_TUNNEL_TBL_RD_OP_ADDR,
++				  PPE_TUNNEL_OP_GET, true, &index);
++	if (ret)
++		return ret;
++
++	return regmap_bulk_read(ppe_dev->regmap,
++				PPE_TUNNEL_TBL_RD_RESULT_ADDR, entry->word,
++				ARRAY_SIZE(entry->word));
++}
++
++int ppe_tunnel_decap_add(struct ppe_device *ppe_dev,
++			 const struct ppe_tunnel_decap_entry *entry,
++			 int *index, struct ppe_tunnel_decap_entry *readback)
++{
++	struct ppe_tunnel_decap_entry verify;
++	int ret, hw_index = 0;
++
++	if (!entry || !index)
++		return -EINVAL;
++	ret = ppe_tunnel_check(ppe_dev);
++	if (ret)
++		return ret;
++
++	*index = -1;
++	if (!readback)
++		readback = &verify;
++	mutex_lock(&ppe_dev->tunnel_lock);
++	ret = regmap_bulk_write(ppe_dev->regmap, PPE_TUNNEL_TBL_OP_DATA_ADDR,
++				entry->word, ARRAY_SIZE(entry->word));
++	if (!ret)
++		ret = ppe_tunnel_op_issue(ppe_dev, PPE_TUNNEL_TBL_OP_ADDR,
++					  PPE_TUNNEL_OP_ADD, false, &hw_index);
++	if (!ret) {
++		/* Publish the returned index before readback. If readback fails,
++		 * the caller can still remove or quarantine the live row.
++		 */
++		*index = hw_index;
++		ret = ppe_tunnel_decap_get_locked(ppe_dev, hw_index, readback);
++	}
++	mutex_unlock(&ppe_dev->tunnel_lock);
++
++	return ret;
++}
++
++int ppe_tunnel_decap_get(struct ppe_device *ppe_dev, int index,
++			 struct ppe_tunnel_decap_entry *entry)
++{
++	int ret;
++
++	if (!entry || index < 0 || index >= PPE_TUNNEL_ENTRIES)
++		return -EINVAL;
++	ret = ppe_tunnel_check(ppe_dev);
++	if (ret)
++		return ret;
++
++	mutex_lock(&ppe_dev->tunnel_lock);
++	ret = ppe_tunnel_decap_get_locked(ppe_dev, index, entry);
++	mutex_unlock(&ppe_dev->tunnel_lock);
++
++	return ret;
++}
++
++int ppe_tunnel_decap_del(struct ppe_device *ppe_dev, int index)
++{
++	u32 counter[PPE_TUNNEL_COUNTER_WORDS] = {};
++	int ret;
++
++	if (index < 0 || index >= PPE_TUNNEL_ENTRIES)
++		return -EINVAL;
++	ret = ppe_tunnel_check(ppe_dev);
++	if (ret)
++		return ret;
++
++	mutex_lock(&ppe_dev->tunnel_lock);
++	ret = ppe_tunnel_op_issue(ppe_dev, PPE_TUNNEL_TBL_OP_ADDR,
++				  PPE_TUNNEL_OP_DEL, true, &index);
++	if (!ret)
++		ret = regmap_bulk_write(ppe_dev->regmap,
++					PPE_TUNNEL_COUNTER_ADDR +
++					index * PPE_TUNNEL_COUNTER_INC,
++					counter, ARRAY_SIZE(counter));
++	mutex_unlock(&ppe_dev->tunnel_lock);
++
++	return ret;
++}
++
++int ppe_tunnel_hw_init(struct ppe_device *ppe_dev)
++{
++	mutex_init(&ppe_dev->tunnel_lock);
++
++	return 0;
++}
+--- /dev/null
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_tunnel.h
+@@ -0,0 +1,27 @@
++/* SPDX-License-Identifier: GPL-2.0-only
++ *
++ * Copyright (c) 2026 Kenneth Kasilag <kenneth@kasilag.me>
++ */
++
++#ifndef __PPE_TUNNEL_H__
++#define __PPE_TUNNEL_H__
++
++#include <linux/types.h>
++
++#define PPE_TUNNEL_DECAP_WORDS		14
++
++struct ppe_device;
++
++struct ppe_tunnel_decap_entry {
++	u32 word[PPE_TUNNEL_DECAP_WORDS];
++};
++
++int ppe_tunnel_hw_init(struct ppe_device *ppe_dev);
++int ppe_tunnel_decap_add(struct ppe_device *ppe_dev,
++			 const struct ppe_tunnel_decap_entry *entry,
++			 int *index, struct ppe_tunnel_decap_entry *readback);
++int ppe_tunnel_decap_get(struct ppe_device *ppe_dev, int index,
++			 struct ppe_tunnel_decap_entry *entry);
++int ppe_tunnel_decap_del(struct ppe_device *ppe_dev, int index);
++
++#endif
diff --git a/target/linux/qualcommbe/patches-6.18/0514-03-net-ethernet-qualcomm-ppe-add-tunnel-encap-transactions.patch b/target/linux/qualcommbe/patches-6.18/0514-03-net-ethernet-qualcomm-ppe-add-tunnel-encap-transactions.patch
new file mode 100644
index 0000000000..5b86d725bc
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0514-03-net-ethernet-qualcomm-ppe-add-tunnel-encap-transactions.patch
@@ -0,0 +1,378 @@
+From: Kenneth Kasilag <kenneth@kasilag.me>
+Date: Sun, 05 Jul 2026 00:00:00 +0000
+Subject: [PATCH] net: ethernet: qualcomm: ppe: add tunnel encap transactions
+
+Add the remaining low-level transactions needed by a shared tunnel-port
+lifecycle. Match the vendor order by writing egress tunnel control before
+its 32-word header template, then bind the verified tunnel ID to a
+dedicated virtual port. Add verified tunnel L3-interface and key-generator
+writes.
+
+Read back directly written tables and restore their previous contents on
+failure. These primitives deliberately do not allocate IDs or publish flow
+rules; the following lifecycle patch will own those dependencies and their
+reverse-order rollback.
+
+Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+@@ -782,6 +782,31 @@
+ #define PPE_TUNNEL_COUNTER_INC			0x10
+ #define PPE_TUNNEL_COUNTER_WORDS		3
+ 
++/* Egress tunnel template and its dedicated virtual-port binding. */
++#define PPE_TUNNEL_ENCAP_HEADER_ADDR		0x054000
++#define PPE_TUNNEL_ENCAP_HEADER_INC		0x80
++#define PPE_TUNNEL_ENCAP_CTRL_ADDR		0x05a000
++#define PPE_TUNNEL_ENCAP_CTRL_INC		0x10
++#define PPE_TUNNEL_EG_VP_ADDR			0x025000
++#define PPE_TUNNEL_EG_VP_ENTRIES		256
++#define PPE_TUNNEL_EG_VP_INC			0x10
++#define PPE_TUNNEL_EG_VP_WORDS			2
++#define PPE_TUNNEL_EG_VP_W1_VALID		BIT(11)
++#define PPE_TUNNEL_EG_VP_W1_ID			GENMASK(18, 12)
++
++/* Per-underlay termination configuration and decap key generation. */
++#define PPE_TUNNEL_PORT_INTF_ADDR		0x302000
