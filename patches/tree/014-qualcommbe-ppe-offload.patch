++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_tunnel.h
+@@ -6,12 +6,15 @@
+ #ifndef __PPE_TUNNEL_H__
+ #define __PPE_TUNNEL_H__
+ 
++#include <linux/if_ether.h>
++#include <linux/in6.h>
