diff --git a/target/linux/qualcommbe/patches-6.18/0505-05-net-ethernet-qualcomm-ppe-offload-tx-flooding.patch b/target/linux/qualcommbe/patches-6.18/0505-05-net-ethernet-qualcomm-ppe-offload-tx-flooding.patch
new file mode 100644
index 0000000000..fe7432d11d
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0505-05-net-ethernet-qualcomm-ppe-offload-tx-flooding.patch
@@ -0,0 +1,333 @@
+From: Kenneth Kasilag <kenneth@kasilag.me>
+Date: Sun, 05 Jul 2026 00:00:00 +0000
+Subject: [PATCH] net: ethernet: qualcomm: ppe: offload TX flooding of VLAN-unaware bridges
+
+Let VLAN-unaware bridges hand over a single copy of flooded packets
+instead of cloning them per port: every replication target of such a
+bridge receives the identical frame, so the EDMA can replicate it with
+a bitmap destination in the transmit descriptor. VLAN-aware bridges
+keep cloning in software, their egress tagging differs per port.
+
+The bridge marks the single copy with offload_fwd_mark on transmit.
+The EDMA picks the replication bitmap by the destination address
+class of the frame from three per-port bitmaps maintained by the
+bridge offload. A bitmap destination bypasses the spanning tree state
+and the hardware multicast groups, so the bitmaps carry what those
+checks would have enforced: ports outside the forwarding state are
+excluded, and the multicast bitmap is the union of the flood members
+and the offloaded group members, which can only over-deliver. The
+bitmaps follow the port flags, the spanning tree changes, the group
+membership and the snooping state.
+
+Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.h
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.h
+@@ -86,12 +86,23 @@ struct edma_port_pcpu_stats {
+  * in the Rx path to mark received packets as hardware forwarded
+  * @flags: Feature flags
+  */
++/* Bridge flood bitmaps of the port for the TX forwarding offload,
++ * selected by the destination address class of the transmitted frame.
++ */
++enum edma_port_br_flood {
++	EDMA_PORT_FLOOD_UC,
++	EDMA_PORT_FLOOD_MC,
++	EDMA_PORT_FLOOD_BC,
++	EDMA_PORT_FLOOD_MAX
++};
++
+ struct edma_port_priv {
+ 	struct ppe_port *ppe_port;
+ 	struct net_device *netdev;
+ 	struct edma_port_pcpu_stats pcpu_stats;
+ 	struct edma_txdesc_ring *txr_map[EDMA_PORT_MAX_CORE];
+ 	bool br_offload;
++	u32 br_flood[EDMA_PORT_FLOOD_MAX];
+ 	unsigned long flags;
+ };
+ 
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
+@@ -7,6 +7,7 @@
+  */
+ 
+ #include <linux/dma-mapping.h>
++#include <linux/etherdevice.h>
+ #include <linux/kernel.h>
+ #include <linux/netdevice.h>
+ #include <linux/platform_device.h>
+@@ -428,6 +429,29 @@ static void edma_tx_fill_desc(struct edm
+ 
+ 	/* Set destination information in the descriptor. */
+ 	EDMA_TXDESC_SERVICE_CODE_SET(txd, PPE_EDMA_SC_BYPASS_ID);
++
++	/* The bridge transmits one copy of a flooded packet when the TX
++	 * forwarding offload is enabled on the port, marked with
++	 * offload_fwd_mark: replicate it to the flood ports of the
++	 * bridge with a bitmap destination.
++	 */
++	if (unlikely(skb->offload_fwd_mark)) {
++		const struct ethhdr *eth = (struct ethhdr *)skb->data;
++		u32 bitmap;
++
++		if (is_broadcast_ether_addr(eth->h_dest))
++			bitmap = READ_ONCE(port_priv->br_flood[EDMA_PORT_FLOOD_BC]);
++		else if (is_multicast_ether_addr(eth->h_dest))
++			bitmap = READ_ONCE(port_priv->br_flood[EDMA_PORT_FLOOD_MC]);
++		else
++			bitmap = READ_ONCE(port_priv->br_flood[EDMA_PORT_FLOOD_UC]);
++
++		if (bitmap) {
++			EDMA_DST_BITMAP_INFO_SET(txd, bitmap);
++			return;
++		}
++	}
++
+ 	EDMA_DST_INFO_SET(txd, port_id);
+ }
+ 
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_tx.h
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_tx.h
+@@ -45,6 +45,14 @@
+ #define EDMA_DST_INFO_SET(desc, x)	((desc)->word4 |= \
+ 	(EDMA_DST_PORT_TYPE_SET(EDMA_DST_PORT_TYPE) | EDMA_DST_PORT_ID_SET(x)))
+ 
++/* A bitmap destination reaches every port of the bitmap with a single
++ * transmitted frame.
++ */
++#define EDMA_DST_PORT_BITMAP_TYPE	3
++#define EDMA_DST_BITMAP_INFO_SET(desc, x)	((desc)->word4 |= \
++	(EDMA_DST_PORT_TYPE_SET(EDMA_DST_PORT_BITMAP_TYPE) | \
++	 EDMA_DST_PORT_ID_SET(x)))
++
+ #define EDMA_TXDESC_TSO_ENABLE_MASK		BIT(24)
+ #define EDMA_TXDESC_TSO_ENABLE_SET(desc, x)	((desc)->word5 |= \
+ 				FIELD_PREP(EDMA_TXDESC_TSO_ENABLE_MASK, x))
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_bridge.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_bridge.c
+@@ -77,6 +77,8 @@ struct ppe_bridge_vsi {
+  * @flags: Offloaded bridge port flags of the port.
+  * @mrouter: Port leads to a multicast router and is included in the
+  * bitmap of every offloaded multicast group of its bridge.
++ * @forwarding: Port is in the forwarding spanning tree state,
++ * a prerequisite for being a TX flood replication target.
+  */
+ struct ppe_bridge_port {
+ 	struct net_device *bridge;
+@@ -85,6 +87,7 @@ struct ppe_bridge_port {
+ 	u16 pvid;
+ 	unsigned long flags;
+ 	bool mrouter;
++	bool forwarding;
+ };
+ 
+ /* The bridge port flags the offload supports, matching the defaults of
+@@ -239,6 +242,8 @@ static int ppe_bridge_vsi_get(struct ppe
+ 	return -ENOSPC;
+ }
+ 
++static void ppe_bridge_tx_flood_update(struct ppe_bridge *pb, int vsi);
++
+ /* Update the member and flood bitmaps of a VSI from its members and
+  * their bridge port flags. The CPU port is always a member and a flood
+  * target, so that packets without a hit on a hardware FDB entry reach
+@@ -272,6 +277,8 @@ static int ppe_bridge_vsi_hw_update(stru
+ 			bc |= BIT(i);
+ 	}
+ 
++	ppe_bridge_tx_flood_update(pb, vsi);
++
+ 	return ppe_vsi_members_set(pb->ppe_dev, vsi, member, uuc, umc, bc);
+ }
+ 
+@@ -553,6 +560,68 @@ static int ppe_bridge_mdb_purge(struct p
+ 	return err;
+ }
+ 
++/* Push the flood bitmaps of a VLAN-unaware bridge to its member port
++ * net devices for the TX forwarding offload: the bridge transmits one
++ * copy of a flooded packet, and the EDMA replicates it along these
++ * bitmaps. A bitmap destination bypasses the spanning tree state and
++ * the hardware groups, so ports outside the forwarding state are
++ * excluded here, and multicast is the union of the flood members and
++ * the offloaded group members, which can only over-deliver.
++ */
++static void ppe_bridge_tx_flood_update(struct ppe_bridge *pb, int vsi)
++{
++	struct ppe_bridge_vsi *v = &pb->vsis[vsi];
++	u32 fwd = 0, uc = 0, mc = 0, bc = 0;
++	struct ppe_bridge_mdb *mdb;
++	int i, bkt;
++
++	if (v->vid)
++		return;
++
++	for (i = 1; i < pb->ppe_dev->num_ports; i++) {
++		if (!(v->members & BIT(i)))
++			continue;
++
++		if (pb->ports[i].forwarding)
++			fwd |= BIT(i);
++		if (pb->ports[i].flags & BR_FLOOD)
++			uc |= BIT(i);
++		if (pb->ports[i].flags & BR_MCAST_FLOOD)
++			mc |= BIT(i);
++		if (pb->ports[i].flags & BR_BCAST_FLOOD)
++			bc |= BIT(i);
++	}
++
++	hash_for_each(pb->mdb_ht, bkt, mdb, node)
++		if (mdb->vsi == vsi)
++			mc |= mdb->ports;
++
++	uc &= fwd;
++	mc &= fwd;
++	bc &= fwd;
++
++	for (i = 1; i < pb->ppe_dev->num_ports; i++) {
++		struct edma_port_priv *port_priv;
++
++		if (!(v->members & BIT(i)) || !pb->ports[i].dev)
++			continue;
++
++		port_priv = netdev_priv(pb->ports[i].dev);
++		WRITE_ONCE(port_priv->br_flood[EDMA_PORT_FLOOD_UC], uc);
++		WRITE_ONCE(port_priv->br_flood[EDMA_PORT_FLOOD_MC], mc);
++		WRITE_ONCE(port_priv->br_flood[EDMA_PORT_FLOOD_BC], bc);
++	}
++}
++
++static void ppe_bridge_port_tx_flood_clear(struct net_device *dev)
++{
++	struct edma_port_priv *port_priv = netdev_priv(dev);
++	int i;
++
++	for (i = 0; i < EDMA_PORT_FLOOD_MAX; i++)
++		WRITE_ONCE(port_priv->br_flood[i], 0);
++}
++
+ /* Release a VSI which lost its last member port: drop its translation
+  * rules, park it back to the CPU-only state the PPE core initialized,
+  * and flush its FDB entries, including the CPU-directed entries which
+@@ -783,6 +852,10 @@ static int ppe_bridge_port_join(struct p
+ 	pb->ports[port].pvid = 0;
+ 	pb->ports[port].flags = PPE_BRIDGE_SUPPORTED_FLAGS;
+ 	pb->ports[port].mrouter = false;
++	/* Excluded from TX flood replication until the bridge reports
++	 * the forwarding state.
++	 */
++	pb->ports[port].forwarding = false;
+ 
+ 	if (!vlan_aware) {
+ 		pb->vsis[vsi].members |= BIT(port);
+@@ -817,10 +890,15 @@ static int ppe_bridge_port_join(struct p
+ 
+ 	ppe_bridge_port_offload_mark_set(dev, true);
+ 
++	/* On a VLAN-unaware bridge every replication target receives
++	 * the identical frame, so the bridge may hand over a single
++	 * copy of flooded packets. VLAN-aware bridges keep cloning in
++	 * software, their egress tagging differs per port.
++	 */
+ 	ret = switchdev_bridge_port_offload(dev, dev, pb,
+ 					    &pb->switchdev_nb,
+ 					    &pb->switchdev_blocking_nb,
+-					    false, extack);
++					    !vlan_aware, extack);
+ 	if (ret)
+ 		goto err_offload;
+ 
+@@ -831,6 +909,7 @@ static int ppe_bridge_port_join(struct p
+ 
+ err_offload:
+ 	ppe_bridge_port_offload_mark_set(dev, false);
++	ppe_bridge_port_tx_flood_clear(dev);
+ 	ppe_port_bridge_txmac_set(ppe_dev, port, false);
+ err_datapath:
+ 	if (!vlan_aware)
+@@ -866,6 +945,7 @@ static void ppe_bridge_port_leave(struct
+ 					&pb->switchdev_blocking_nb);
+ 
+ 	ppe_bridge_port_offload_mark_set(dev, false);
++	ppe_bridge_port_tx_flood_clear(dev);
+ 	ppe_port_bridge_txmac_set(ppe_dev, port, false);
+ 
+ 	if (!vlan_aware)
+@@ -1121,9 +1201,12 @@ static int ppe_bridge_port_mdb_add(struc
+ 			hash_del(&mdb->node);
+ 			kfree(mdb);
+ 		}
++		return ret;
+ 	}
+ 
+-	return ret;
++	ppe_bridge_tx_flood_update(pb, vsi);
++
++	return 0;
+ }
+ 
+ static int ppe_bridge_port_mdb_del(struct ppe_bridge *pb,
+@@ -1149,18 +1232,19 @@ static int ppe_bridge_port_mdb_del(struc
+ 		ret = ppe_bridge_mdb_hw_update(pb, mdb);
+ 		if (ret)
+ 			mdb->ports |= BIT(port);
+-		return ret;
+-	}
+-
+-	ret = ppe_bridge_mdb_hw_remove(pb, mdb);
+-	if (ret) {
+-		mdb->ports |= BIT(port);
+-		return ret;
++	} else {
++		ret = ppe_bridge_mdb_hw_remove(pb, mdb);
++		if (ret) {
++			mdb->ports |= BIT(port);
++		} else {
++			hash_del(&mdb->node);
++			kfree(mdb);
++		}
+ 	}
+ 
+-	hash_del(&mdb->node);
+-	kfree(mdb);
+-	return 0;
++	if (!ret)
++		ppe_bridge_tx_flood_update(pb, vsi);
++	return ret;
+ }
+ 
+ static int ppe_bridge_stp_state_set(struct ppe_bridge *pb,
+@@ -1193,6 +1277,10 @@ static int ppe_bridge_stp_state_set(stru
+ 	if (ret)
+ 		return ret;
+ 
++	pb->ports[port].forwarding = stp_state == PPE_STP_STATE_FORWARDING;
++	if (pb->ports[port].vsi >= 0)
++		ppe_bridge_tx_flood_update(pb, pb->ports[port].vsi);
++
+ 	if (stp_state != PPE_STP_STATE_FORWARDING)
+ 		ret = ppe_fdb_port_flush(ppe_dev, port, false);
+ 
+@@ -1314,8 +1402,19 @@ static int ppe_bridge_mc_disabled_set(st
+ 	int port = ppe_bridge_port_id(dev);
+ 	struct net_device *br = pb->ports[port].bridge;
+ 
+-	if (disabled)
+-		return ppe_bridge_mdb_purge(pb, br, -1);
++	if (disabled) {
++		int i;
++
++		int ret;
++
++		ret = ppe_bridge_mdb_purge(pb, br, -1);
++		if (ret)
++			return ret;
++
++		for (i = 0; i < ARRAY_SIZE(pb->vsis); i++)
++			if (pb->vsis[i].br == br)
++				ppe_bridge_tx_flood_update(pb, i);
++	}
+ 
+ 	return 0;
+ }
diff --git a/target/linux/qualcommbe/patches-6.18/0506-01-net-ethernet-qualcomm-ppe-add-l3-flow-engine-registers.patch b/target/linux/qualcommbe/patches-6.18/0506-01-net-ethernet-qualcomm-ppe-add-l3-flow-engine-registers.patch
new file mode 100644
index 0000000000..c6b2b03175
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0506-01-net-ethernet-qualcomm-ppe-add-l3-flow-engine-registers.patch
@@ -0,0 +1,240 @@
+From: Kenneth Kasilag <kenneth@kasilag.me>
+Date: Sat, 04 Jul 2026 00:00:00 +0000
+Subject: [PATCH] net: ethernet: qualcomm: ppe: add L3 flow engine registers
+
+Add the register and table layouts of the PPE L3 flow engine, taken
+from the SSDK: the router MAC table, the ingress and egress L3
+interface tables, the public NAT address table, the next hop table,
+the flow and host tables with their independent operation registers, the
+per-flow hit counters, and the flow control registers holding the
+lookup enable and the hardware flow aging timer.
+
+The direct IPv4 flow-table view is a six-word row within its eight-word
+stride, matching the SSDK table accessor used for validity updates.
+The indirect operation-data window is twelve words, and FLOW_CTRL1 has
+separate IPv4-unicast, IPv6-unicast and multicast rows.
+
+Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+@@ -207,6 +207,15 @@
+ #define PPE_EG_VLAN_MODE_UNMODIFIED		2
+ #define PPE_EG_VLAN_MODE_UNTOUCHED		3
+ 
++/* Egress L3 interfaces, providing the source MAC rewrite of routed
++ * packets. Indexed like the ingress L3 interface table.
++ */
++#define PPE_EG_L3_IF_TBL_ADDR			0x23000
++#define PPE_EG_L3_IF_TBL_ENTRIES		256
++#define PPE_EG_L3_IF_TBL_INC			0x10
++#define PPE_EG_L3_IF_W0_MAC_ADDR_LO		GENMASK(31, 0)
++#define PPE_EG_L3_IF_W1_MAC_ADDR_HI		GENMASK(15, 0)
++
+ /* PPE service code configuration on the egress direction. */
+ #define PPE_EG_SERVICE_TBL_ADDR			0x43000
+ #define PPE_EG_SERVICE_TBL_ENTRIES		256
+@@ -514,6 +523,188 @@
+ #define PPE_IPR_PKT_CNT_TBL_ENTRIES		8
+ #define PPE_IPR_PKT_CNT_TBL_INC			4
+ 
++/* Router MAC addresses. Packets with a matching destination MAC take the
++ * L3 route path, including the flow table lookup.
++ */
++#define PPE_MY_MAC_TBL_ADDR			0x200000
++#define PPE_MY_MAC_TBL_ENTRIES			8
++#define PPE_MY_MAC_TBL_INC			0x8
++#define PPE_MY_MAC_W0_MAC_ADDR_LO		GENMASK(31, 0)
++#define PPE_MY_MAC_W1_MAC_ADDR_HI		GENMASK(15, 0)
++#define PPE_MY_MAC_W1_VALID			BIT(16)
++
++/* Global L3 failure policy programmed by the vendor PPE probe. */
++#define PPE_L3_ROUTE_CTRL_ADDR			0x200480
++#define PPE_L3_ROUTE_CTRL_IP_MRU_FAIL		GENMASK(1, 0)
++#define PPE_L3_ROUTE_CTRL_IP_MRU_DEACCEL	BIT(2)
++#define PPE_L3_ROUTE_CTRL_IP_MTU_FAIL		GENMASK(4, 3)
++#define PPE_L3_ROUTE_CTRL_IP_MTU_DEACCEL	BIT(5)
++#define PPE_L3_ROUTE_CTRL_IP_MTU_DF_FAIL	GENMASK(7, 6)
++
++#define PPE_L3_ROUTE_CTRL_EXT_ADDR		0x200494
++#define PPE_L3_ROUTE_CTRL_EXT_ROUTE_MISMATCH	GENMASK(1, 0)
++#define PPE_L3_ROUTE_CTRL_EXT_HOST_HASH_MODE_0	GENMASK(4, 3)
++#define PPE_L3_ROUTE_CTRL_EXT_HOST_HASH_MODE_1	GENMASK(6, 5)
++
++/* Global control of the L3 flow engine. The aging timer applies to the
++ * age field of the flow entries; it is left disabled, the flow table
++ * users manage the entry lifetime themselves.
++ */
++#define PPE_FLOW_CTRL0_ADDR			0x2004a8
++#define PPE_FLOW_CTRL0_FLOW_EN			BIT(0)
++#define PPE_FLOW_CTRL0_AGE_TIMER		GENMASK(20, 5)
++#define PPE_FLOW_CTRL0_AGE_TIMER_UNIT		GENMASK(22, 21)
++
++/* Per-packet-type key selection: IPv4 unicast, IPv6 unicast and
++ * multicast. Each register holds five direction groups, and the key-select
++ * bit of each chooses the source (0) or destination (1) IP as the lookup key.
++ */
++#define PPE_FLOW_CTRL1_ADDR			0x2004bc
++#define PPE_FLOW_CTRL1_ENTRIES			3
++#define PPE_FLOW_CTRL1_INC			0x4
++#define PPE_FLOW_CTRL1_KEY_SEL			(BIT(5) | BIT(11) | \
++						 BIT(17) | BIT(23) | \
++						 BIT(29))
++
++/* Public IP addresses used as the translated source of SNAT flows,
++ * referenced by index from the next hop entries.
++ */
++#define PPE_PUB_IP_TBL_ADDR			0x2004d8
++#define PPE_PUB_IP_TBL_ENTRIES			16
++#define PPE_PUB_IP_TBL_INC			4
++
++/* Flow and host tables have independent hash-operation engines. */
++#define PPE_FLOW_TBL_OP_ADDR			0x200528
++#define PPE_FLOW_OP_CMD_ID			GENMASK(3, 0)
++#define PPE_FLOW_OP_TYPE			GENMASK(7, 5)
++#define PPE_FLOW_OP_HASH_BLOCK_BITMAP		GENMASK(9, 8)
++#define PPE_FLOW_OP_MODE			BIT(10)
++#define PPE_FLOW_OP_ENTRY_INDEX			GENMASK(23, 12)
++#define PPE_FLOW_TBL_OP_DATA_ADDR		0x200550
++#define PPE_FLOW_TBL_OP_DATA_WORDS		12
++#define PPE_FLOW_TBL_OP_RSLT_ADDR		0x2005c4
++#define PPE_FLOW_OP_RSLT_CMD_ID			GENMASK(3, 0)
++#define PPE_FLOW_OP_RSLT_FAIL			BIT(4)
++#define PPE_FLOW_OP_RSLT_ENTRY_INDEX		GENMASK(16, 5)
++#define PPE_FLOW_OP_RSLT_VALID_CNT		GENMASK(20, 17)
++
++#define PPE_HOST_TBL_OP_ADDR			0x200724
++#define PPE_HOST_OP_CMD_ID			GENMASK(3, 0)
++#define PPE_HOST_OP_TYPE			GENMASK(7, 5)
++#define PPE_HOST_OP_HASH_BLOCK_BITMAP		GENMASK(9, 8)
++#define PPE_HOST_OP_MODE			BIT(10)
++#define PPE_HOST_OP_ENTRY_INDEX			GENMASK(23, 11)
++#define PPE_HOST_TBL_OP_DATA_ADDR		0x200738
++#define PPE_HOST_TBL_OP_DATA_WORDS		10
++#define PPE_HOST_TBL_OP_RSLT_ADDR		0x200770
++#define PPE_HOST_OP_RSLT_CMD_ID			GENMASK(3, 0)
++#define PPE_HOST_OP_RSLT_FAIL			BIT(4)
++#define PPE_HOST_OP_RSLT_ENTRY_INDEX		GENMASK(17, 5)
++#define PPE_HOST_OP_RSLT_VALID_CNT		GENMASK(21, 18)
++
++/* Ingress L3 interfaces, the per-interface route configuration. */
++#define PPE_IN_L3_IF_TBL_ADDR			0x206000
++#define PPE_IN_L3_IF_TBL_ENTRIES		256
++#define PPE_IN_L3_IF_TBL_INC			0x10
++#define PPE_IN_L3_IF_W0_MRU			GENMASK(13, 0)
++#define PPE_IN_L3_IF_W0_MTU			GENMASK(27, 14)
++#define PPE_IN_L3_IF_W0_TTL_DEC_BYPASS		BIT(28)
++#define PPE_IN_L3_IF_W0_IPV4_UC_ROUTE_EN	BIT(29)
++#define PPE_IN_L3_IF_W0_IPV6_UC_ROUTE_EN	BIT(30)
++#define PPE_IN_L3_IF_W0_ICMP_TRIGGER_EN		BIT(31)
++#define PPE_IN_L3_IF_W1_TTL_EXCEED_CMD		GENMASK(1, 0)
++#define PPE_IN_L3_IF_W1_TTL_EXCEED_DEACCEL	BIT(2)
++#define PPE_IN_L3_IF_W1_MAC_BITMAP		GENMASK(10, 3)
++#define PPE_IN_L3_IF_W1_PPPOE_EN		BIT(11)
++#define PPE_IN_L3_IF_W1_DMAC_CHECK_DIS		BIT(12)
++#define PPE_IN_L3_IF_W1_MRU_IPV6		GENMASK(31, 18)
++#define PPE_IN_L3_IF_W2_MTU_IPV6		GENMASK(13, 0)
++#define PPE_IN_L3_IF_W2_UDP_CSM0_CMD		GENMASK(15, 14)
++#define PPE_IN_L3_IF_UDP_CSM0_MAPT_RECALCULATE	2
++
++/* Host table entries hold the second IP address of a flow, referenced
++ * by index from the flow entries. The destination info field uses the
++ * same encoding as the FDB entries.
++ */
++#define PPE_HOST_TBL_ADDR			0x220000
++#define PPE_HOST_TBL_ENTRIES			6144
++#define PPE_HOST_TBL_INC			0x10
++#define PPE_HOST_W0_VALID			BIT(0)
++#define PPE_HOST_W0_KEY_TYPE			GENMASK(2, 1)
++#define PPE_HOST_W0_FWD_CMD			GENMASK(4, 3)
++#define PPE_HOST_W0_DST_INFO			GENMASK(19, 6)
++#define PPE_HOST_W0_LAN_WAN			BIT(20)
++#define PPE_HOST_W1_IP_ADDR			GENMASK(31, 0)
++
++/* L3 flow table, keyed by the hardware-hashed 5-tuple. One IP address
++ * of the tuple is inline, the other is referenced in the host table.
++ * The forward type selects the routing and NAT behavior; the next hop
++ * entry provides the egress rewrite, and the L4 port field holds the
++ * translated source port of SNAT flows and the translated destination
++ * port of DNAT flows.
++ */
++#define PPE_FLOW_TBL_ADDR			0x240000
++#define PPE_FLOW_TBL_ENTRIES			4096
++#define PPE_FLOW_TBL_INC			0x20
++#define PPE_FLOW_TBL_WORDS			6
++#define PPE_FLOW_W0_VALID			BIT(0)
++#define PPE_FLOW_W0_ENTRY_TYPE			BIT(1)
++#define PPE_FLOW_W0_HOST_INDEX_TYPE		BIT(2)
++#define PPE_FLOW_W0_HOST_INDEX			GENMASK(15, 3)
++#define PPE_FLOW_W0_PROTOCOL_TYPE		GENMASK(17, 16)
++#define PPE_FLOW_W0_AGE				GENMASK(19, 18)
++#define PPE_FLOW_W0_SRC_L3_IF_VALID		BIT(20)
++#define PPE_FLOW_W0_SRC_L3_IF			GENMASK(28, 21)
++#define PPE_FLOW_W0_FWD_TYPE			GENMASK(31, 29)
++#define PPE_FLOW_W1_NEXT_HOP			GENMASK(11, 0)
++#define PPE_FLOW_W1_L4_PORT			GENMASK(27, 12)
++#define PPE_FLOW_W1_DE_ACCE			BIT(28)
++#define PPE_FLOW_W1_COPY_TO_CPU			BIT(29)
++#define PPE_FLOW_W2_SERVICE_CODE		GENMASK(11, 4)
++#define PPE_FLOW_W2_IP_ADDR_LO			GENMASK(31, 12)
++#define PPE_FLOW_W3_IP_ADDR_HI			GENMASK(11, 0)
++#define PPE_FLOW_W3_L4_SPORT			GENMASK(27, 12)
++#define PPE_FLOW_W3_L4_DPORT_LO			GENMASK(31, 28)
++#define PPE_FLOW_W4_L4_DPORT_HI			GENMASK(11, 0)
++
++#define PPE_FLOW_FWD_TYPE_FORWARD		0
++#define PPE_FLOW_FWD_TYPE_SNAT			1
