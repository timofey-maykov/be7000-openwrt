++static int ppe_tunnel_vp_bind_locked(struct ppe_device *ppe_dev, int vp,
++				     bool valid, int tunnel_id)
++{
++	u32 reg = PPE_TUNNEL_EG_VP_ADDR + vp * PPE_TUNNEL_EG_VP_INC;
++	u32 old[PPE_TUNNEL_EG_VP_WORDS], val[PPE_TUNNEL_EG_VP_WORDS];
++	u32 verify[PPE_TUNNEL_EG_VP_WORDS];
++	int ret;
++
++	ret = regmap_bulk_read(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
++	if (ret)
++		return ret;
++	memcpy(val, old, sizeof(val));
++	FIELD_MODIFY(PPE_TUNNEL_EG_VP_W1_VALID, &val[1], valid);
++	FIELD_MODIFY(PPE_TUNNEL_EG_VP_W1_ID, &val[1], tunnel_id);
++	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
++	if (ret)
++		return ret;
++	ret = regmap_bulk_read(ppe_dev->regmap, reg, verify,
++			       ARRAY_SIZE(verify));
++	if (!ret && !memcmp(verify, val, sizeof(verify)))
++		return 0;
++	if (!ret)
++		ret = -EIO;
++	if (regmap_bulk_write(ppe_dev->regmap, reg, old, ARRAY_SIZE(old)))
++		dev_err(ppe_dev->dev, "failed to restore tunnel VP %d\n", vp);
++
++	return ret;
++}
++
++int ppe_tunnel_vp_bind(struct ppe_device *ppe_dev, int vp, int tunnel_id)
++{
++	int ret;
++
++	if (vp < 0 || vp >= PPE_TUNNEL_EG_VP_ENTRIES || tunnel_id < 0 ||
++	    tunnel_id >= PPE_TUNNEL_ENTRIES)
++		return -EINVAL;
++	ret = ppe_tunnel_check(ppe_dev);
++	if (ret)
++		return ret;
++
++	mutex_lock(&ppe_dev->tunnel_lock);
++	ret = ppe_tunnel_vp_bind_locked(ppe_dev, vp, true, tunnel_id);
++	mutex_unlock(&ppe_dev->tunnel_lock);
++
++	return ret;
++}
++
++int ppe_tunnel_vp_unbind(struct ppe_device *ppe_dev, int vp)
++{
++	int ret;
++
++	if (vp < 0 || vp >= PPE_TUNNEL_EG_VP_ENTRIES)
++		return -EINVAL;
++	ret = ppe_tunnel_check(ppe_dev);
++	if (ret)
++		return ret;
++
++	mutex_lock(&ppe_dev->tunnel_lock);
++	ret = ppe_tunnel_vp_bind_locked(ppe_dev, vp, false, 0);
++	mutex_unlock(&ppe_dev->tunnel_lock);
++
++	return ret;
++}
++
++/* Write @count words at @reg, read them back to prove the write took
++ * effect, and restore @old on any failure. The caller holds tunnel_lock
++ * and reports @what/@id in the restore-failure message.
++ */
++static int ppe_tunnel_write_verify(struct ppe_device *ppe_dev, u32 reg,
++				   const u32 *old, const u32 *val, int count,
++				   const char *what, int id)
++{
++	u32 verify[PPE_TUNNEL_KEY_WORDS];
++	int ret;
++
++	if (WARN_ON_ONCE(count > ARRAY_SIZE(verify)))
++		return -EINVAL;
++
++	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, count);
++	if (!ret)
++		ret = regmap_bulk_read(ppe_dev->regmap, reg, verify, count);
++	if (!ret && memcmp(verify, val, count * sizeof(*val)))
++		ret = -EIO;
++	if (ret && regmap_bulk_write(ppe_dev->regmap, reg, old, count))
++		dev_err(ppe_dev->dev, "failed to restore %s %d\n", what, id);
++
++	return ret;
++}
++
