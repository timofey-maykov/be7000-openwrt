+ #include "ppe_config.h"
+ #include "ppe_flow.h"
+ #include "ppe_flowtable.h"
++#include "ppe_vp.h"
+ #include "ppe_regs.h"
+ #include "ppe_tunnel.h"
+ 
+@@ -173,6 +174,7 @@ struct ppe_ft_flow {
+ 	int pppoe;
+ 	int vlan;
+ 	int tunnel;
++	int vp;
+ 	u8 eport;
+ 	u32 packets;
+ 	u64 bytes;
+@@ -892,6 +894,15 @@ static int ppe_ft_vlan_xlt(int index)
+ 	return PPE_XLT_RULE_TBL_ENTRIES - PPE_L3_VLAN_UPLINKS + index;
+ }
+ 
++/* The egress L3 interface a virtual port owns; its region starts
++ * where the VLAN-uplink one ends.
++ */
++static int ppe_ft_vp_l3_if(struct ppe_flowtable *ft, int vp)
++{
++	return ppe_ft_vlan_l3_if(ft, PPE_L3_VLAN_UPLINKS) +
++	       (vp - PPE_VP_PORT_BASE);
++}
++
+ /* Get a refcounted VLAN uplink slot of (port, VID), programming its
+  * L3 interface, VSI binding and translation rule on first use. Must
+  * be called with the flowtable lock held.
+@@ -1779,6 +1790,7 @@ static int ppe_ft_flow_replace(struct pp
+ 	flow->pppoe = -1;
+ 	flow->vlan = -1;
+ 	flow->tunnel = -1;
++	flow->vp = -1;
+ 	nh.vid = -1;
+ 	data.pppoe_sid = -1;
+ 	data.ingress_vid = -1;
+@@ -2040,12 +2052,17 @@ static int ppe_ft_flow_replace(struct pp
+ 			dev_hold(tdev);
+ 	}
+ 
+-	if (!odev || (!tunnel_encap && !edma_port_dev_check(odev)) ||
+-	    (vlan_pops && data.ingress_vid < 0) ||
++	if (!odev || (vlan_pops && data.ingress_vid < 0) ||
+ 	    is_zero_ether_addr(data.eth.dst)) {
+ 		ret = -EOPNOTSUPP;
+ 		goto err_tdev;
+ 	}
++	if (!tunnel_encap && !edma_port_dev_check(odev) &&
++	    (!ft->ppe_dev->variant->has_vports ||
++	     odev->type != ARPHRD_ETHER || !odev->ieee80211_ptr)) {
++		ret = -EOPNOTSUPP;
++		goto err_tdev;
++	}
+ 
+ 	/* The PPPoE L3 interface carries the session ID, so it needs
+ 	 * the source MAC rewrite of the rule to be complete.
+@@ -2082,9 +2099,18 @@ static int ppe_ft_flow_replace(struct pp
+ 	}
+ 
+ 	if (!tunnel_encap) {
+-		port_priv = netdev_priv(odev);
+-		nh.port = port_priv->ppe_port->port_id;
+-		nh.l3_if = nh.port;
++		if (edma_port_dev_check(odev)) {
++			port_priv = netdev_priv(odev);
++			nh.port = port_priv->ppe_port->port_id;
