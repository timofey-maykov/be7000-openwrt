diff --git a/target/linux/generic/hack-6.18/768-net-ppp-publish-channel-lifecycle-events.patch b/target/linux/generic/hack-6.18/768-net-ppp-publish-channel-lifecycle-events.patch
new file mode 100644
index 0000000000..df9ad83838
--- /dev/null
+++ b/target/linux/generic/hack-6.18/768-net-ppp-publish-channel-lifecycle-events.patch
@@ -0,0 +1,200 @@
+From: Kenneth Kasilag <kenneth@kasilag.me>
+Date: Wed, 15 Jul 2026 00:00:00 +0000
+Subject: [PATCH] net: ppp: publish channel lifecycle events
+
+Hardware forwarding drivers need to create encapsulation interfaces when a
+PPP channel joins a PPP netdevice and remove them when it leaves. Inferring
+that lifetime from individual flow rules makes the two flow directions race
+and loses the session when one direction expires first.
+
+Publish first-channel connect and last-channel disconnect through a
+blocking PPP notifier API implemented in always-built networking core. The
+PPP netdevice identifies the affected topology. Events run after the
+association changes and outside the channel and unit spinlocks.
+Notifications do not veto the userspace operation.
+
+Serialize the first/last transitions and their blocking callbacks per PPP
+unit. The attached channel reference pins the unit across notification, and
+the namespace-wide PPP mutex is released before invoking consumers.
+
+This is transport-neutral. Consumers can use the existing forward-path API
+to recover PPPoE, VLAN and physical-device topology without exposing PPPoE
+socket internals from the generic layer. Keeping the notifier chain in core
+also lets a built-in hardware driver observe a modular PPP implementation
+without introducing a reverse symbol dependency.
+
+Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
+---
+--- a/drivers/net/ppp/ppp_generic.c
++++ b/drivers/net/ppp/ppp_generic.c
+@@ -124,6 +124,7 @@ struct ppp {
+ 	struct file	*owner;		/* file that owns this unit 48 */
+ 	struct list_head channels;	/* list of attached channels 4c */
+ 	int		n_channels;	/* how many channels are attached 54 */
++	struct mutex	channel_event_mutex; /* serializes lifecycle events */
+ 	spinlock_t	rlock;		/* lock for receive side 58 */
+ 	spinlock_t	wlock;		/* lock for transmit side 5c */
+ 	struct ppp_xmit_recursion __percpu *xmit_recursion; /* xmit recursion detect */
+@@ -1255,6 +1256,7 @@ static int ppp_dev_configure(struct net
+ 	for (indx = 0; indx < NUM_NP; ++indx)
+ 		ppp->npmode[indx] = NPMODE_PASS;
+ 	INIT_LIST_HEAD(&ppp->channels);
++	mutex_init(&ppp->channel_event_mutex);
+ 	spin_lock_init(&ppp->rlock);
+ 	spin_lock_init(&ppp->wlock);
+ 
+@@ -3465,6 +3467,7 @@ static void ppp_destroy_interface(struct
+ 
+ 	kfree_skb(ppp->xmit_pending);
+ 	free_percpu(ppp->xmit_recursion);
++	mutex_destroy(&ppp->channel_event_mutex);
+ 
+ 	free_netdev(ppp->dev);
+ }
+@@ -3515,6 +3518,7 @@ ppp_connect_channel(struct channel *pch,
+ {
+ 	struct ppp *ppp;
+ 	struct ppp_net *pn;
++	bool first_channel = false;
+ 	int ret = -ENXIO;
+ 	int hdrlen;
+ 
+@@ -3524,12 +3528,15 @@ ppp_connect_channel(struct channel *pch,
+ 	ppp = ppp_find_unit(pn, unit);
+ 	if (!ppp)
+ 		goto out;
++	/* Keep the first-channel transition and its blocking notification
++	 * ordered against a racing last-channel disconnect.
++	 */
++	mutex_lock(&ppp->channel_event_mutex);
+ 	spin_lock(&pch->upl);
+ 	ret = -EINVAL;
+ 	if (rcu_dereference_protected(pch->ppp, lockdep_is_held(&pch->upl)) ||
+ 	    rcu_dereference_protected(pch->bridge, lockdep_is_held(&pch->upl)))
+ 		goto outl;
+-
+ 	ppp_lock(ppp);
+ 	spin_lock_bh(&pch->downl);
+ 	if (!pch->chan) {
+@@ -3551,6 +3558,7 @@ ppp_connect_channel(struct channel *pch,
+ 		ppp->dev->hard_header_len = hdrlen;
+ 	list_add_tail_rcu(&pch->clist, &ppp->channels);
+ 	++ppp->n_channels;
++	first_channel = ppp->n_channels == 1;
+ 	rcu_assign_pointer(pch->ppp, ppp);
+ 	refcount_inc(&ppp->file.refcnt);
+ 	ppp_unlock(ppp);
+@@ -3558,6 +3566,11 @@ ppp_connect_channel(struct channel *pch,
+ 
+  outl:
+ 	spin_unlock(&pch->upl);
++	mutex_unlock(&pn->all_ppp_mutex);
++	if (!ret && first_channel)
++		ppp_channel_notify(PPP_CHANNEL_CONNECT, ppp->dev);
++	mutex_unlock(&ppp->channel_event_mutex);
++	return ret;
+  out:
+ 	mutex_unlock(&pn->all_ppp_mutex);
+ 	return ret;
+@@ -3570,18 +3583,26 @@ static int
+ ppp_disconnect_channel(struct channel *pch)
+ {
+ 	struct ppp *ppp;
++	bool last_channel;
+ 	int err = -EINVAL;
+ 
+ 	spin_lock(&pch->upl);
+ 	ppp = rcu_replace_pointer(pch->ppp, NULL, lockdep_is_held(&pch->upl));
+ 	spin_unlock(&pch->upl);
+ 	if (ppp) {
+-		/* remove it from the ppp unit's list */
++		/* The channel reference keeps the unit alive while this mutex
++		 * orders removal and notification after a racing connect.
++		 */
++		mutex_lock(&ppp->channel_event_mutex);
+ 		ppp_lock(ppp);
+ 		list_del_rcu(&pch->clist);
+-		if (--ppp->n_channels == 0)
++		last_channel = --ppp->n_channels == 0;
++		if (last_channel)
+ 			wake_up_interruptible(&ppp->file.rwait);
+ 		ppp_unlock(ppp);
++		if (last_channel)
++			ppp_channel_notify(PPP_CHANNEL_DISCONNECT, ppp->dev);
++		mutex_unlock(&ppp->channel_event_mutex);
+ 		synchronize_net();
+ 		if (refcount_dec_and_test(&ppp->file.refcnt))
+ 			ppp_destroy_interface(ppp);
+--- a/include/linux/ppp_channel.h
++++ b/include/linux/ppp_channel.h
+@@ -20,10 +20,17 @@
+ #include <linux/poll.h>
+ #include <net/net_namespace.h>
+ 
++struct net_device;
+ struct net_device_path;
+ struct net_device_path_ctx;
++struct notifier_block;
+ struct ppp_channel;
+ 
++enum ppp_channel_event {
++	PPP_CHANNEL_CONNECT,
++	PPP_CHANNEL_DISCONNECT,
++};
++
+ struct ppp_channel_ops {
+ 	/* Send a packet (or multilink fragment) on this channel.
+ 	   Returns 1 if it was accepted, 0 if not. */
+@@ -75,6 +82,13 @@ extern int ppp_unit_number(struct ppp_ch
+ /* Get the device name associated with a channel, or NULL if none */
+ extern char *ppp_dev_name(struct ppp_channel *);
+ 
++/* First-channel connect and last-channel disconnect notifications.
++ * Callbacks may sleep and are serialized across transitions of one PPP unit.
++ */
++int ppp_register_channel_notifier(struct notifier_block *nb);
++int ppp_unregister_channel_notifier(struct notifier_block *nb);
++int ppp_channel_notify(unsigned long event, struct net_device *ppp_dev);
++
+ /*
+  * SMP locking notes:
+  * The channel code must ensure that when it calls ppp_unregister_channel,
+--- a/net/core/Makefile
++++ b/net/core/Makefile
+@@ -17,7 +17,7 @@ obj-y		     += dev.o dev_api.o dev_addr_
+ 
+ obj-$(CONFIG_NETDEV_ADDR_LIST_TEST) += dev_addr_lists_test.o
+ 
+-obj-y += net-sysfs.o
++obj-y += net-sysfs.o ppp_channel.o
+ obj-y += hotdata.o
+ obj-y += netdev_rx_queue.o
+ obj-y += netdev_queues.o
+--- /dev/null
++++ b/net/core/ppp_channel.c
+@@ -0,0 +1,25 @@
++// SPDX-License-Identifier: GPL-2.0-or-later
++#include <linux/export.h>
++#include <linux/notifier.h>
++#include <linux/ppp_channel.h>
++
++static BLOCKING_NOTIFIER_HEAD(ppp_channel_notifier_list);
++
++int ppp_register_channel_notifier(struct notifier_block *nb)
++{
++	return blocking_notifier_chain_register(&ppp_channel_notifier_list, nb);
++}
++EXPORT_SYMBOL_GPL(ppp_register_channel_notifier);
++
++int ppp_unregister_channel_notifier(struct notifier_block *nb)
++{
++	return blocking_notifier_chain_unregister(&ppp_channel_notifier_list, nb);
++}
++EXPORT_SYMBOL_GPL(ppp_unregister_channel_notifier);
++
++int ppp_channel_notify(unsigned long event, struct net_device *ppp_dev)
++{
++	return blocking_notifier_call_chain(&ppp_channel_notifier_list, event,
++					    ppp_dev);
++}
++EXPORT_SYMBOL_GPL(ppp_channel_notify);
diff --git a/target/linux/generic/hack-6.18/769-net-ip6-tunnel-publish-flow-offload-parameters.patch b/target/linux/generic/hack-6.18/769-net-ip6-tunnel-publish-flow-offload-parameters.patch
new file mode 100644
index 0000000000..c6776466ea
--- /dev/null
+++ b/target/linux/generic/hack-6.18/769-net-ip6-tunnel-publish-flow-offload-parameters.patch
@@ -0,0 +1,225 @@
+From: Kenneth Kasilag <kenneth@kasilag.me>
+Date: Fri, 17 Jul 2026 00:00:00 +0800
+Subject: [PATCH] net: ip6_tunnel: publish flow offload parameters
+
+Flow offload drivers need a stable copy of an IPv6 tunnel's endpoints,
+underlay link, hop limit and MTU.  MAP-E makes the remote endpoint
+flow-dependent, so copying struct ip6_tnl is neither sufficient nor safe:
+the FMR list is replaced under RTNL and remains private to ip6_tunnel.
+
+Add a netdevice operation which snapshots the fixed parameters and derives
+the MAP-E remote endpoint from an inner IPv4 address and transport port.
+The generic wrapper requires RTNL, allowing the tunnel implementation to
+walk its FMR list without exposing its lifetime to hardware drivers.  A
+netdevice operation avoids a link-time dependency from a built-in offload
+driver to the possibly modular IPv6 tunnel implementation.
+
+Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
+---
+--- a/include/linux/netdevice.h
++++ b/include/linux/netdevice.h
+@@ -61,6 +61,8 @@ struct kernel_hwtstamp_config;
+ struct phy_device;
+ struct dsa_port;
+ struct ip_tunnel_parm_kern;
++struct ip6_tnl_flow_offload_key;
++struct ip6_tnl_flow_offload_info;
+ struct macsec_context;
+ struct macsec_ops;
+ struct netdev_config;
+@@ -1390,6 +1392,11 @@ struct netdev_net_notifier {
+  *	The caller must be under RCU read context.
+  * int (*ndo_fill_forward_path)(struct net_device_path_ctx *ctx, struct net_device_path *path);
+  *     Get the forwarding path to reach the real device from the HW destination address
++ * int (*ndo_ip6_tnl_flow_offload)(struct net_device *dev,
++ *                                const struct ip6_tnl_flow_offload_key *key,
++ *                                struct ip6_tnl_flow_offload_info *info);
++ *     Snapshot an IPv6 tunnel's fixed parameters and resolve a per-flow
++ *     MAP-E remote endpoint. The caller holds RTNL.
+  * ktime_t (*ndo_get_tstamp)(struct net_device *dev,
+  *			     const struct skb_shared_hwtstamps *hwtstamps,
+  *			     bool cycles);
+@@ -1645,6 +1652,10 @@ struct net_device_ops {
+ 	struct net_device *	(*ndo_get_peer_dev)(struct net_device *dev);
+ 	int                     (*ndo_fill_forward_path)(struct net_device_path_ctx *ctx,
+                                                          struct net_device_path *path);
++	int			(*ndo_ip6_tnl_flow_offload)(
++					struct net_device *dev,
++					const struct ip6_tnl_flow_offload_key *key,
++					struct ip6_tnl_flow_offload_info *info);
+ 	ktime_t			(*ndo_get_tstamp)(struct net_device *dev,
+ 						  const struct skb_shared_hwtstamps *hwtstamps,
+ 						  bool cycles);
+@@ -3367,6 +3378,9 @@ int dev_get_iflink(const struct net_devi
+ int dev_fill_metadata_dst(struct net_device *dev, struct sk_buff *skb);
+ int dev_fill_forward_path(const struct net_device *dev, const u8 *daddr,
+ 			  struct net_device_path_stack *stack);
++int dev_ip6_tnl_flow_offload(struct net_device *dev,
++			     const struct ip6_tnl_flow_offload_key *key,
++			     struct ip6_tnl_flow_offload_info *info);
+ struct net_device *dev_get_by_name(struct net *net, const char *name);
+ struct net_device *dev_get_by_name_rcu(struct net *net, const char *name);
+ struct net_device *__dev_get_by_name(struct net *net, const char *name);
+--- a/include/net/ip6_tunnel.h
++++ b/include/net/ip6_tunnel.h
+@@ -30,6 +30,32 @@ struct __ip6_tnl_fmr {
+ 	__u8 offset;
+ };
+ 
++/**
++ * struct ip6_tnl_flow_offload_key - Inner flow fields used by MAP-E
++ * @addr: IPv4 address embedded in the remote MAP endpoint
++ * @port: Transport port from which the PSID is derived
++ */
++struct ip6_tnl_flow_offload_key {
++	__be32 addr;
++	__be16 port;
++};
++
++/**
++ * struct ip6_tnl_flow_offload_info - Stable IPv6 tunnel snapshot
++ * @local: Local outer IPv6 endpoint
++ * @remote: Fixed or MAP-E-derived remote outer IPv6 endpoint
++ * @link: Configured underlay ifindex
++ * @mtu: Tunnel netdevice MTU
++ * @hop_limit: Configured outer hop limit
++ */
++struct ip6_tnl_flow_offload_info {
++	struct in6_addr local;
++	struct in6_addr remote;
++	int link;
++	int mtu;
++	u8 hop_limit;
++};
++
+ struct __ip6_tnl_parm {
+ 	char name[IFNAMSIZ];	/* name of tunnel device */
+ 	int link;		/* ifindex of underlying L2 interface */
+--- a/net/core/dev.c
++++ b/net/core/dev.c
+@@ -734,6 +734,19 @@ int dev_fill_metadata_dst(struct net_dev
+ }
+ EXPORT_SYMBOL_GPL(dev_fill_metadata_dst);
+ 
++int dev_ip6_tnl_flow_offload(struct net_device *dev,
++			     const struct ip6_tnl_flow_offload_key *key,
++			     struct ip6_tnl_flow_offload_info *info)
++{
++	ASSERT_RTNL();
++
++	if (!dev->netdev_ops->ndo_ip6_tnl_flow_offload)
++		return -EOPNOTSUPP;
++
++	return dev->netdev_ops->ndo_ip6_tnl_flow_offload(dev, key, info);
++}
++EXPORT_SYMBOL_GPL(dev_ip6_tnl_flow_offload);
++
+ static struct net_device_path *dev_fwd_path(struct net_device_path_stack *stack)
+ {
+ 	int k = stack->num_paths++;
+--- a/net/ipv6/ip6_tunnel.c
++++ b/net/ipv6/ip6_tunnel.c
+@@ -920,6 +920,95 @@ static void ip4ip6_fmr_calc(struct in6_a
+ 	}
+ }
+ 
++static bool ip6_tnl_fmr_matches(__be32 addr,
++				const struct __ip6_tnl_fmr *fmr)
++{
++	u32 mask;
++
++	if (fmr->ip4_prefix_len > 32)
++		return false;
++
++	mask = fmr->ip4_prefix_len ?
++		htonl(~0U << (32 - fmr->ip4_prefix_len)) : 0;
++	return (addr & mask) == (fmr->ip4_prefix.s_addr & mask);
++}
++
++static bool ip6_tnl_fmr_remote(struct in6_addr *remote,
++			       const struct __ip6_tnl_fmr *fmrs,
++			       __be32 addr, __be16 port)
++{
++	const struct __ip6_tnl_fmr *fmr;
++
++	for (fmr = fmrs; fmr; fmr = fmr->next) {
++		unsigned int suffix, psid_len, frombyte, fromrem, bytes;
++		u16 psid_bits = 0;
++		u64 ea_bits, value = 0, mask;
++
++		if (!ip6_tnl_fmr_matches(addr, fmr) ||
++		    fmr->ip6_prefix_len > 64 || fmr->ea_len > 48 ||
++		    fmr->ip6_prefix_len + fmr->ea_len > 64)
++			continue;
++		suffix = 32 - fmr->ip4_prefix_len;
++		if (fmr->ea_len < suffix)
++			continue;
++		psid_len = fmr->ea_len - suffix;
++		if (psid_len > 16 || fmr->offset > 16 - psid_len)
++			continue;
++
++		ea_bits = fmr->ip4_prefix_len < 32 ?
++			(u64)ntohl(addr) << (32 + fmr->ip4_prefix_len) : 0;
++		if (psid_len) {
++			psid_bits = ntohs(port) >>
++				(16 - psid_len - fmr->offset);
++			psid_bits <<= 16 - psid_len;
++			ea_bits |= (u64)psid_bits <<
++				(48 - (fmr->ea_len - psid_len));
++		}
++
++		*remote = fmr->ip6_prefix;
++		memcpy(&remote->s6_addr[10], &addr, sizeof(addr));
++		remote->s6_addr16[7] =
++			htons(psid_len ? psid_bits >> (16 - psid_len) : 0);
++
++		frombyte = fmr->ip6_prefix_len / 8;
++		fromrem = fmr->ip6_prefix_len % 8;
++		bytes = min_t(unsigned int, sizeof(*remote) - frombyte,
++			      sizeof(value));
++		memcpy(&value, &remote->s6_addr[frombyte], bytes);
++		value = be64_to_cpu(value);
++		mask = fmr->ea_len ?
++			GENMASK_ULL(63 - fromrem,
++				    64 - fmr->ea_len - fromrem) : 0;
++		value = cpu_to_be64((value & ~mask) | (ea_bits >> fromrem));
++		memcpy(&remote->s6_addr[frombyte], &value, bytes);
++
++		return true;
++	}
++
++	return false;
++}
++
++static int ip6_tnl_flow_offload(struct net_device *dev,
++				const struct ip6_tnl_flow_offload_key *key,
++				struct ip6_tnl_flow_offload_info *info)
++{
++	const struct ip6_tnl *t = netdev_priv(dev);
++
++	ASSERT_RTNL();
++
++	info->local = t->parms.laddr;
++	info->remote = t->parms.raddr;
++	info->link = t->parms.link;
++	info->mtu = dev->mtu;
++	info->hop_limit = t->parms.hop_limit;
++
++	if (t->parms.fmrs &&
++	    !ip6_tnl_fmr_remote(&info->remote, t->parms.fmrs,
++				key->addr, key->port))
++		return -ENOENT;
++
++	return 0;
++}
+ 
+ static int __ip6_tnl_rcv(struct ip6_tnl *tunnel, struct sk_buff *skb,
+ 			 const struct tnl_ptk_info *tpi,
+@@ -2011,6 +2100,7 @@ static const struct net_device_ops ip6_t
+ 	.ndo_change_mtu = ip6_tnl_change_mtu,
+ 	.ndo_get_stats64 = dev_get_tstats64,
+ 	.ndo_get_iflink = ip6_tnl_get_iflink,
++	.ndo_ip6_tnl_flow_offload = ip6_tnl_flow_offload,
+ };
+ 
+ #define IPXIPX_FEATURES (NETIF_F_SG |		\
diff --git a/target/linux/generic/hack-6.18/901-debloat_sock_diag.patch b/target/linux/generic/hack-6.18/901-debloat_sock_diag.patch
