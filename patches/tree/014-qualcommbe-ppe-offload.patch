++/**
++ * ppe_mac_trap_update - Update a reserved destination MAC trap
++ * @ppe_dev: PPE device
++ * @index: Index of the reserved MAC address and of its trap rule
++ * @addr: MAC address to trap when enabling the rule
++ * @enable: Enable the trap, or remove it when false
++ *
++ * Program the reserved MAC address table and a control packet rule to
++ * redirect matching packets to the CPU port from all ports, bypassing
++ * the ingress spanning tree state and VLAN filtering. Used to trap
++ * link-local protocol packets such as BPDUs, which must reach the CPU
++ * even on a port in the blocking state.
++ *
++ * Return: 0 on success, negative error code on failure.
++ */
++static int ppe_mac_trap_update(struct ppe_device *ppe_dev, int index,
++			       const u8 *addr, bool enable)
++{
++	u32 rfdb_reg, app_reg, rfdb_old[2], app_old[3];
++	u32 rfdb_cfg[2] = {}, app_cfg[3] = {};
++	int ret, err;
++
++	if (index < 0 || index >= PPE_RFDB_TBL_ENTRIES ||
++	    index >= PPE_APP_CTRL_ENTRIES || (enable && !addr))
++		return -EINVAL;
++
++	rfdb_reg = PPE_RFDB_TBL_ADDR + PPE_RFDB_TBL_INC * index;
++	app_reg = PPE_APP_CTRL_ADDR + PPE_APP_CTRL_INC * index;
++	ret = regmap_bulk_read(ppe_dev->regmap, rfdb_reg, rfdb_old,
++			       ARRAY_SIZE(rfdb_old));
++	if (ret)
++		return ret;
++	ret = regmap_bulk_read(ppe_dev->regmap, app_reg, app_old,
++			       ARRAY_SIZE(app_old));
++	if (ret)
++		return ret;
++
++	if (enable) {
++		rfdb_cfg[0] = (u32)addr[2] << 24 | addr[3] << 16 |
++			      addr[4] << 8 | addr[5];
++		rfdb_cfg[1] = FIELD_PREP(PPE_RFDB_W1_MAC_ADDR_HI,
++					 addr[0] << 8 | addr[1]) |
++			      PPE_RFDB_W1_VALID;
++		app_cfg[0] = PPE_APP_CTRL_W0_VALID |
++			     PPE_APP_CTRL_W0_RFDB_INCLUDE |
++			     FIELD_PREP(PPE_APP_CTRL_W0_RFDB_BITMAP_LO,
++					index < 30 ? BIT(index) : 0);
++		app_cfg[1] = FIELD_PREP(PPE_APP_CTRL_W1_RFDB_BITMAP_HI,
++					index < 30 ? 0 : BIT(index - 30));
++		app_cfg[2] = PPE_APP_CTRL_W2_IN_VLAN_FLTR_BYP |
++			     PPE_APP_CTRL_W2_IN_STG_BYP |
++			     FIELD_PREP(PPE_APP_CTRL_W2_CMD,
++					PPE_ACTION_REDIRECT_TO_CPU);
++	}
++
++	/* Publish the application rule last and invalidate it first. */
++	if (!enable) {
++		ret = regmap_bulk_write(ppe_dev->regmap, app_reg, app_cfg,
++					ARRAY_SIZE(app_cfg));
++		if (ret)
++			return ret;
++	}
++	ret = regmap_bulk_write(ppe_dev->regmap, rfdb_reg, rfdb_cfg,
++				ARRAY_SIZE(rfdb_cfg));
++	if (!ret && enable)
++		ret = regmap_bulk_write(ppe_dev->regmap, app_reg, app_cfg,
++					ARRAY_SIZE(app_cfg));
++	if (!ret)
++		return 0;
++
++	/* Restore with the same invalidate-before-key ordering. */
++	err = regmap_bulk_write(ppe_dev->regmap, app_reg, app_cfg,
++				ARRAY_SIZE(app_cfg));
++	err |= regmap_bulk_write(ppe_dev->regmap, rfdb_reg, rfdb_old,
++				 ARRAY_SIZE(rfdb_old));
++	err |= regmap_bulk_write(ppe_dev->regmap, app_reg, app_old,
++				 ARRAY_SIZE(app_old));
++	if (err)
++		dev_err(ppe_dev->dev,
++			"failed to restore reserved MAC trap %d\n", index);
++	return ret;
++}
++
++int ppe_mac_trap_set(struct ppe_device *ppe_dev, int index, const u8 *addr)
++{
++	return ppe_mac_trap_update(ppe_dev, index, addr, true);
++}
++
++int ppe_mac_trap_clear(struct ppe_device *ppe_dev, int index)
++{
++	return ppe_mac_trap_update(ppe_dev, index, NULL, false);
++}
