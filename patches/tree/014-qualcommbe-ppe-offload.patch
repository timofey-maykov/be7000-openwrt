++	mutex_lock(&ppe_dev->tunnel_lock);
++	ret = regmap_bulk_read(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
++	if (ret)
++		goto out;
++	memcpy(val, old, sizeof(val));
++	FIELD_MODIFY(PPE_TUNNEL_PORT_INTF_W0_L3_VALID, &val[0], valid);
++	FIELD_MODIFY(PPE_TUNNEL_PORT_INTF_W0_L3_INDEX, &val[0], l3_if);
++	ret = ppe_tunnel_write_verify(ppe_dev, reg, old, val, ARRAY_SIZE(val),
++				      "tunnel port interface", port);
++out:
++	mutex_unlock(&ppe_dev->tunnel_lock);
++
++	return ret;
++}
++
++int ppe_tunnel_l3_if_set(struct ppe_device *ppe_dev, int index, u32 value)
