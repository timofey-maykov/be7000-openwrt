++static int ppe_tunnel_encap_restore(struct ppe_device *ppe_dev, int tunnel_id,
++				    const u32 *control, const u32 *header)
++{
++	u32 disabled[PPE_TUNNEL_ENCAP_CTRL_WORDS] = {};
++	u32 ctrl_reg = PPE_TUNNEL_ENCAP_CTRL_ADDR +
++		       tunnel_id * PPE_TUNNEL_ENCAP_CTRL_INC;
++	u32 hdr_reg = PPE_TUNNEL_ENCAP_HEADER_ADDR +
++		      tunnel_id * PPE_TUNNEL_ENCAP_HEADER_INC;
++	int ret, err;
++
++	ret = regmap_bulk_write(ppe_dev->regmap, ctrl_reg, disabled,
++				ARRAY_SIZE(disabled));
++	err = regmap_bulk_write(ppe_dev->regmap, hdr_reg, header,
++				PPE_TUNNEL_ENCAP_HEADER_WORDS);
++	if (!ret)
++		ret = err;
++	err = regmap_bulk_write(ppe_dev->regmap, ctrl_reg, control,
++				PPE_TUNNEL_ENCAP_CTRL_WORDS);
++	if (!ret)
++		ret = err;
++
++	return ret;
++}
++
++int ppe_tunnel_encap_set(struct ppe_device *ppe_dev, int tunnel_id,
++			 const struct ppe_tunnel_encap_entry *entry)
++{
++	struct ppe_tunnel_encap_entry old, verify;
++	u32 ctrl_reg, hdr_reg;
++	int ret, restore_ret;
++
++	if (!entry || tunnel_id < 0 || tunnel_id >= PPE_TUNNEL_ENTRIES)
++		return -EINVAL;
++	ret = ppe_tunnel_check(ppe_dev);
++	if (ret)
++		return ret;
++
++	ctrl_reg = PPE_TUNNEL_ENCAP_CTRL_ADDR +
++		   tunnel_id * PPE_TUNNEL_ENCAP_CTRL_INC;
++	hdr_reg = PPE_TUNNEL_ENCAP_HEADER_ADDR +
++		  tunnel_id * PPE_TUNNEL_ENCAP_HEADER_INC;
++
++	mutex_lock(&ppe_dev->tunnel_lock);
++	ret = regmap_bulk_read(ppe_dev->regmap, ctrl_reg, old.control,
++			       ARRAY_SIZE(old.control));
++	if (ret)
++		goto out;
++	ret = regmap_bulk_read(ppe_dev->regmap, hdr_reg, old.header,
++			       ARRAY_SIZE(old.header));
++	if (ret)
++		goto out;
++
++	/* Match the vendor order. The VP is not bound until both rows verify. */
++	ret = regmap_bulk_write(ppe_dev->regmap, ctrl_reg, entry->control,
++				ARRAY_SIZE(entry->control));
++	if (ret)
++		goto restore;
++	ret = regmap_bulk_write(ppe_dev->regmap, hdr_reg, entry->header,
++				ARRAY_SIZE(entry->header));
++	if (ret)
++		goto restore;
++	ret = regmap_bulk_read(ppe_dev->regmap, ctrl_reg, verify.control,
++			       ARRAY_SIZE(verify.control));
++	if (ret)
++		goto restore;
++	ret = regmap_bulk_read(ppe_dev->regmap, hdr_reg, verify.header,
++			       ARRAY_SIZE(verify.header));
++	if (ret)
++		goto restore;
++	if (memcmp(&verify, entry, sizeof(verify))) {
++		ret = -EIO;
++		goto restore;
++	}
++	goto out;
++
++restore:
++	restore_ret = ppe_tunnel_encap_restore(ppe_dev, tunnel_id,
++					       old.control, old.header);
++	if (restore_ret)
++		dev_err(ppe_dev->dev,
++			"failed to restore tunnel encap %d: %d\n",
++			tunnel_id, restore_ret);
++out:
++	mutex_unlock(&ppe_dev->tunnel_lock);
++	return ret;
++}
++
++int ppe_tunnel_encap_clear(struct ppe_device *ppe_dev, int tunnel_id)
++{
++	struct ppe_tunnel_encap_entry entry = {};
++
++	return ppe_tunnel_encap_set(ppe_dev, tunnel_id, &entry);
++}
