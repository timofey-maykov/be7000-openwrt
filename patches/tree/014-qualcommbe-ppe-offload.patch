++#define PPE_TUNNEL_TBL_ADDR			0x304000
++#define PPE_TUNNEL_TBL_INC			0x40
++#define PPE_TUNNEL_TBL_DECAP_EN_WORD		11
++#define PPE_TUNNEL_TBL_DECAP_EN			BIT(20)
+ #define PPE_TUNNEL_OP_TYPE			GENMASK(2, 0)
+ #define PPE_TUNNEL_OP_HASH_BLOCK_BITMAP		GENMASK(4, 3)
+ #define PPE_TUNNEL_OP_MODE			BIT(5)
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_tunnel.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_tunnel.c
