diff --git a/target/linux/qualcommbe/patches-6.18/0505-03-net-ethernet-qualcomm-ppe-age-out-learned-fdb-entries.patch b/target/linux/qualcommbe/patches-6.18/0505-03-net-ethernet-qualcomm-ppe-age-out-learned-fdb-entries.patch
