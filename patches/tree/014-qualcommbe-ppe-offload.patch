+ 		flow->eport = nh.port;
+ 		ether_addr_copy(nh.mac, data.eth.dst);
+ 	}
+@@ -2160,7 +2186,7 @@ static int ppe_ft_flow_replace(struct pp
+ 		if (data.sport != flow->entry.sport ||
+ 		    data.dport != flow->entry.dport) {
+ 			ret = -EOPNOTSUPP;
+-			goto err_unlock;
++			goto err_vp;
+ 		}
+ 
+ 		flow->entry.fwd_type = PPE_FLOW_FWD_TYPE_ROUTE;
+@@ -2169,7 +2195,7 @@ static int ppe_ft_flow_replace(struct pp
+ 		   (data.dip != flow->entry.dip.ip4 ||
