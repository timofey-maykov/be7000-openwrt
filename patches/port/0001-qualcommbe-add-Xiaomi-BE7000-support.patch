diff --git a/package/kernel/mac80211/patches/ath11k/951-wifi-ath11k-use-iommu-paging-domain-allocator.patch b/package/kernel/mac80211/patches/ath11k/951-wifi-ath11k-use-iommu-paging-domain-allocator.patch
