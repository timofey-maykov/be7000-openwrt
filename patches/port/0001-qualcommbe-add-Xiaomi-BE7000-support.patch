diff --git a/target/linux/qualcommbe/patches-6.18/0705-remoteproc-qcom-q6v5-wcss-load-m3-firmware.patch b/target/linux/qualcommbe/patches-6.18/0705-remoteproc-qcom-q6v5-wcss-load-m3-firmware.patch
