+
+QCN9274 firmware can report direct buffer module identifiers that are not
+implemented by the upstream ath12k direct buffer table. Treat those entries
+as unsupported capabilities and skip them instead of failing WMI service
+ready parsing.
+
+This keeps the supported direct buffer capabilities available while allowing
+the radio to finish initialization on firmware that advertises newer module
+IDs.
+
+Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
+---
+--- a/drivers/net/wireless/ath/ath12k/wmi.c
++++ b/drivers/net/wireless/ath/ath12k/wmi.c
+@@ -4691,7 +4691,7 @@ static int ath12k_wmi_dma_ring_caps(stru
+ 	struct ath12k_wmi_dma_ring_caps_params *dma_caps;
+ 	struct ath12k_dbring_cap *dir_buff_caps;
+ 	int ret;
+-	u32 i;
++	u32 i, valid_caps = 0;
+ 
+ 	dma_caps_parse->n_dma_ring_caps = 0;
+ 	dma_caps = (struct ath12k_wmi_dma_ring_caps_params *)ptr;
+@@ -4718,25 +4718,24 @@ static int ath12k_wmi_dma_ring_caps(stru
+ 	dir_buff_caps = ab->db_caps;
+ 	for (i = 0; i < dma_caps_parse->n_dma_ring_caps; i++) {
+ 		if (le32_to_cpu(dma_caps[i].module_id) >= WMI_DIRECT_BUF_MAX) {
+-			ath12k_warn(ab, "Invalid module id %d\n",
++			ath12k_warn(ab, "ignoring unsupported direct buffer module id %d\n",
+ 				    le32_to_cpu(dma_caps[i].module_id));
+-			ret = -EINVAL;
+-			goto free_dir_buff;
++			continue;
+ 		}
+ 
+-		dir_buff_caps[i].id = le32_to_cpu(dma_caps[i].module_id);
+-		dir_buff_caps[i].pdev_id =
++		dir_buff_caps[valid_caps].id = le32_to_cpu(dma_caps[i].module_id);
++		dir_buff_caps[valid_caps].pdev_id =
+ 			DP_HW2SW_MACID(le32_to_cpu(dma_caps[i].pdev_id));
+-		dir_buff_caps[i].min_elem = le32_to_cpu(dma_caps[i].min_elem);
+-		dir_buff_caps[i].min_buf_sz = le32_to_cpu(dma_caps[i].min_buf_sz);
+-		dir_buff_caps[i].min_buf_align = le32_to_cpu(dma_caps[i].min_buf_align);
++		dir_buff_caps[valid_caps].min_elem = le32_to_cpu(dma_caps[i].min_elem);
++		dir_buff_caps[valid_caps].min_buf_sz = le32_to_cpu(dma_caps[i].min_buf_sz);
++		dir_buff_caps[valid_caps].min_buf_align =
++			le32_to_cpu(dma_caps[i].min_buf_align);
++		valid_caps++;
+ 	}
+ 
+-	return 0;
++	ab->num_db_cap = valid_caps;
+ 
+-free_dir_buff:
+-	ath12k_wmi_free_dbring_caps(ab);
+-	return ret;
++	return 0;
+ }
+ 
+ static void
diff --git a/package/kernel/mac80211/patches/ath12k/304-wifi-ath12k-force-unique-qcn9274-qrtr-instance.patch b/package/kernel/mac80211/patches/ath12k/304-wifi-ath12k-force-unique-qcn9274-qrtr-instance.patch
new file mode 100644
index 0000000000..fe5d962427
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath12k/304-wifi-ath12k-force-unique-qcn9274-qrtr-instance.patch
@@ -0,0 +1,50 @@
+Subject: wifi: ath12k: force unique QCN9274 QRTR instance
+
+QCN9274 firmware on Xiaomi BE7000 can expose a WLFW QRTR service that
+collides with the integrated IPQ9574 ath11k service unless the PCIe QRTR
+node id is programmed before MHI starts. Generate and write the unique
+PCIe-derived QRTR instance for QCN9274 even when the firmware feature
+advertisement does not request it.
+
+Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
+---
+--- a/drivers/net/wireless/ath/ath12k/pci.c
++++ b/drivers/net/wireless/ath/ath12k/pci.c
+@@ -726,6 +726,13 @@ static int ath12k_pci_config_irq(struct
+ 	return 0;
+ }
+ 
++static bool ath12k_pci_needs_unique_qrtr_node(struct ath12k_base *ab)
++{
++	return ath12k_fw_feature_supported(ab, ATH12K_FW_FEATURE_MULTI_QRTR_ID) ||
++	       ab->hw_rev == ATH12K_HW_QCN9274_HW10 ||
++	       ab->hw_rev == ATH12K_HW_QCN9274_HW20;
++}
++
+ static void ath12k_pci_init_qmi_ce_config(struct ath12k_base *ab)
+ {
+ 	struct ath12k_qmi_ce_cfg *cfg = &ab->qmi.ce_cfg;
+@@ -740,11 +747,13 @@ static void ath12k_pci_init_qmi_ce_confi
+ 	cfg->svc_to_ce_map_len = ab->hw_params->svc_to_ce_map_len;
+ 	ab->qmi.service_ins_id = ab->hw_params->qmi_service_ins_id;
+ 
+-	if (ath12k_fw_feature_supported(ab, ATH12K_FW_FEATURE_MULTI_QRTR_ID)) {
++	if (ath12k_pci_needs_unique_qrtr_node(ab)) {
+ 		ab_pci->qmi_instance =
+ 			u32_encode_bits(pci_domain_nr(bus), DOMAIN_NUMBER_MASK) |
+ 			u32_encode_bits(bus->number, BUS_NUMBER_MASK);
+ 		ab->qmi.service_ins_id += ab_pci->qmi_instance;
++		ath12k_info(ab, "pci qmi instance 0x%x service 0x%x\n",
++			    ab_pci->qmi_instance, ab->qmi.service_ins_id);
+ 	}
+ }
+ 
+@@ -1490,7 +1499,7 @@ int ath12k_pci_power_up(struct ath12k_ba
+ 
+ 	ath12k_pci_msi_enable(ab_pci);
+ 
+-	if (ath12k_fw_feature_supported(ab, ATH12K_FW_FEATURE_MULTI_QRTR_ID))
++	if (ath12k_pci_needs_unique_qrtr_node(ab))
+ 		ath12k_pci_update_qrtr_node_id(ab);
+ 
+ 	ret = ath12k_mhi_start(ab_pci);
diff --git a/package/kernel/mac80211/patches/ath12k/305-wifi-ath12k-use-dt-mac-address.patch b/package/kernel/mac80211/patches/ath12k/305-wifi-ath12k-use-dt-mac-address.patch
new file mode 100644
index 0000000000..62923e3f56
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath12k/305-wifi-ath12k-use-dt-mac-address.patch
@@ -0,0 +1,44 @@
+Subject: wifi: ath12k: use DT MAC address
+
+Some ath12k PCI radios are paired with board specific NVMEM layouts where the
+device MAC address is described in the device tree. Match ath11k behaviour and
+prefer a valid firmware node MAC address over the target supplied base address.
+
+Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
+---
+ drivers/net/wireless/ath/ath12k/mac.c | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+--- a/drivers/net/wireless/ath/ath12k/mac.c
++++ b/drivers/net/wireless/ath/ath12k/mac.c
+@@ -8,6 +8,7 @@
+ #include <net/mac80211.h>
+ #include <net/cfg80211.h>
+ #include <linux/etherdevice.h>
++#include <linux/property.h>
+ 
+ #include "mac.h"
+ #include "core.h"
+@@ -13743,6 +13744,7 @@ static int ath12k_mac_hw_register(struct
+ 	u32 ht_cap = U32_MAX, antennas_rx = 0, antennas_tx = 0;
+ 	bool is_6ghz = false, is_raw_mode = false, is_monitor_disable = false;
+ 	u8 *mac_addr = NULL;
++	u8 dt_mac_addr[ETH_ALEN] = {};
+ 	u8 mbssid_max_interfaces = 0;
+ 
+ 	wiphy->max_ap_assoc_sta = 0;
+@@ -13755,7 +13757,13 @@ static int ath12k_mac_hw_register(struct
+ 		if (ar->ab->pdevs_macaddr_valid) {
+ 			ether_addr_copy(ar->mac_addr, pdev->mac_addr);
+ 		} else {
+-			ether_addr_copy(ar->mac_addr, ar->ab->mac_addr);
++			if (i == 0)
++				device_get_mac_address(ar->ab->dev, dt_mac_addr);
++
++			if (is_valid_ether_addr(dt_mac_addr))
++				ether_addr_copy(ar->mac_addr, dt_mac_addr);
++			else
++				ether_addr_copy(ar->mac_addr, ar->ab->mac_addr);
+ 			ar->mac_addr[4] += ar->pdev_idx;
+ 		}
+ 
diff --git a/package/kernel/mac80211/patches/ath12k/306-wifi-ath12k-use-fixed-memory-region-for-pci.patch b/package/kernel/mac80211/patches/ath12k/306-wifi-ath12k-use-fixed-memory-region-for-pci.patch
new file mode 100644
index 0000000000..c061d010a3
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath12k/306-wifi-ath12k-use-fixed-memory-region-for-pci.patch
@@ -0,0 +1,135 @@
+Subject: wifi: ath12k: use fixed memory region for PCI devices
+
+ath12k already has a fixed-memory QMI path for platforms that describe
+firmware memory through the memory-region property, but only the AHB bus
+enables it.  Some IPQ9574 boards describe their external QCN9224/QCN9274
+PCIe radios with stock firmware memory reservations as well.
+
+Enable the fixed-memory path for PCI devices when the DT node contains a
+memory-region property.  For PCI radios, split the single reserved block
+using the QCN9224 stock firmware layout so HOST DDR, M3, CALDB and
+pageable requests are all satisfied from deterministic physical addresses
+instead of relying on large dynamic coherent DMA allocations during QMI
+memory negotiation.
+
+Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
+---
+ drivers/net/wireless/ath/ath12k/pci.c |  7 +++++
+ drivers/net/wireless/ath/ath12k/qmi.c | 68 ++++++++++++++++++++++++++++++++++
+ 2 files changed, 75 insertions(+)
+
+--- a/drivers/net/wireless/ath/ath12k/pci.c
++++ b/drivers/net/wireless/ath/ath12k/pci.c
+@@ -1573,6 +1573,7 @@ static int ath12k_pci_probe(struct pci_d
+ 	struct ath12k_pci *ab_pci;
+ 	u32 soc_hw_version_major, soc_hw_version_minor;
+ 	int ret;
++	u32 addr;
+ 
+ 	ab = ath12k_core_alloc(&pdev->dev, sizeof(*ab_pci), ATH12K_BUS_PCI);
+ 	if (!ab) {
+@@ -1592,6 +1593,12 @@ static int ath12k_pci_probe(struct pci_d
+ 	pci_set_drvdata(pdev, ab);
+ 	spin_lock_init(&ab_pci->window_lock);
+ 
++	/* If firmware memory is reserved in DT, avoid the large dynamic
++	 * coherent DMA allocation used by the default QMI memory path.
++	 */
++	if (!of_property_read_u32(ab->dev->of_node, "memory-region", &addr))
++		set_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags);
++
+ 	ret = ath12k_pci_claim(ab_pci, pdev);
+ 	if (ret) {
+ 		ath12k_err(ab, "failed to claim device: %d\n", ret);
+--- a/drivers/net/wireless/ath/ath12k/qmi.c
++++ b/drivers/net/wireless/ath/ath12k/qmi.c
+@@ -19,6 +19,10 @@
+ #define PLATFORM_CAP_PCIE_GLOBAL_RESET	0x08
+ #define ATH12K_QMI_MAX_CHUNK_SIZE	2097152
+ 
++#define ATH12K_QMI_QCN9224_M3_OFFSET		0x1c00000
++#define ATH12K_QMI_QCN9224_CALDB_OFFSET		0x1e00000
++#define ATH12K_QMI_QCN9224_PAGEABLE_OFFSET	0x2600000
++
+ static const struct qmi_elem_info wlfw_host_mlo_chip_info_s_v01_ei[] = {
+ 	{
+ 		.data_type      = QMI_UNSIGNED_1_BYTE,
+@@ -2723,6 +2727,39 @@ err:
+ 	return ret;
+ }
+ 
++static int ath12k_qmi_assign_pci_fixed_mem_chunk(struct ath12k_base *ab,
++						 int idx, int i, u32 offset)
++{
++	struct reserved_mem *rmem;
++	size_t avail_rmem_size;
++
++	rmem = ath12k_core_get_reserved_mem(ab, 0);
++	if (!rmem)
++		return -ENODEV;
++
++	if (offset > rmem->size)
++		return -EINVAL;
++
++	avail_rmem_size = rmem->size - offset;
++	if (avail_rmem_size < ab->qmi.target_mem[i].size) {
++		ath12k_dbg(ab, ATH12K_DBG_QMI,
++			   "failed to assign mem type %u req size %u offset %u avail size %zu\n",
++			   ab->qmi.target_mem[i].type,
++			   ab->qmi.target_mem[i].size,
++			   offset, avail_rmem_size);
++		return -EINVAL;
++	}
++
++	ab->qmi.target_mem[idx].paddr = rmem->base + offset;
++	ab->qmi.target_mem[idx].v.ioaddr =
++		ioremap(ab->qmi.target_mem[idx].paddr,
++			ab->qmi.target_mem[i].size);
++	if (!ab->qmi.target_mem[idx].v.ioaddr)
++		return -EIO;
++
++	return 0;
++}
++
+ static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
+ {
+ 	struct reserved_mem *rmem;
+@@ -2730,6 +2766,38 @@ static int ath12k_qmi_assign_target_mem_
+ 	int i, idx, ret;
+ 
+ 	for (i = 0, idx = 0; i < ab->qmi.mem_seg_count; i++) {
++		if (ab->hif.bus == ATH12K_BUS_PCI) {
++			switch (ab->qmi.target_mem[i].type) {
++			case HOST_DDR_REGION_TYPE:
++				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i, 0);
++				break;
++			case M3_DUMP_REGION_TYPE:
++				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i,
++									    ATH12K_QMI_QCN9224_M3_OFFSET);
++				break;
++			case CALDB_MEM_REGION_TYPE:
++				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i,
++									    ATH12K_QMI_QCN9224_CALDB_OFFSET);
++				break;
++			case PAGEABLE_MEM_REGION_TYPE:
++				ret = ath12k_qmi_assign_pci_fixed_mem_chunk(ab, idx, i,
++									    ATH12K_QMI_QCN9224_PAGEABLE_OFFSET);
++				break;
++			default:
++				ath12k_dbg(ab, ATH12K_DBG_QMI,
++					   "qmi ignore unsupported mem req type %u size %u index %d\n",
++					   ab->qmi.target_mem[i].type,
++					   ab->qmi.target_mem[i].size, i);
++				continue;
++			}
++			if (ret)
++				goto out;
++			ab->qmi.target_mem[idx].size = ab->qmi.target_mem[i].size;
++			ab->qmi.target_mem[idx].type = ab->qmi.target_mem[i].type;
++			idx++;
++			continue;
++		}
++
+ 		switch (ab->qmi.target_mem[i].type) {
+ 		case HOST_DDR_REGION_TYPE:
+ 			rmem = ath12k_core_get_reserved_mem(ab, 0);
