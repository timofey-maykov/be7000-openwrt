diff --git a/package/kernel/mac80211/patches/ath11k/952-wifi-ath11k-drop-pcie-pme-capability-for-ipq9574.patch b/package/kernel/mac80211/patches/ath11k/952-wifi-ath11k-drop-pcie-pme-capability-for-ipq9574.patch
