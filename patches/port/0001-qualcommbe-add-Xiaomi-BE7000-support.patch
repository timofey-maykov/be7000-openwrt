++	ret = devm_clk_bulk_get(wcss->dev, wcss->num_pre_boot_clks,
++				wcss->pre_boot_clks);
++	if (ret < 0)
++		return ret;
++
++	return devm_clk_bulk_get(wcss->dev, wcss->num_clks, wcss->clks);
++}
++
