+++ b/target/linux/qualcommbe/patches-6.18/0705-remoteproc-qcom-q6v5-wcss-load-m3-firmware.patch
@@ -0,0 +1,125 @@
+Subject: remoteproc: qcom_q6v5_wcss: load M3 firmware
+
+Allow WCSS remoteproc targets to load an optional M3 firmware image in
+addition to the Q6 firmware. IPQ9574 firmware packages provide both
+images, and loading M3 matches the IPQ9574 remoteproc bring-up series.
+
+Signed-off-by: Alexandru Gagniuc <mr.nuke.me@gmail.com>
+Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
+---
+Changes since v1:
+ - Check for -ENOENT from q6v5_wcss_load_aux()
+---
+ drivers/remoteproc/qcom_q6v5_wcss.c | 45 +++++++++++++++++++++++++----
+ 1 file changed, 40 insertions(+), 5 deletions(-)
+
+Index: linux-6.18.35/drivers/remoteproc/qcom_q6v5_wcss.c
+===================================================================
+--- linux-6.18.35.orig/drivers/remoteproc/qcom_q6v5_wcss.c	2026-06-19 21:07:59.851573443 +0000
++++ linux-6.18.35/drivers/remoteproc/qcom_q6v5_wcss.c	2026-06-19 21:07:59.867573445 +0000
+@@ -103,7 +103,8 @@
+ };
+ 
+ struct wcss_data {
+-	const char *firmware_name;
++	const char *q6_firmware_name;
++	const char *m3_firmware_name;
+ 	unsigned int crash_reason_smem;
+ 	u32 version;
+ 	bool aon_reset_required;
+@@ -163,6 +164,7 @@
+ 	unsigned int crash_reason_smem;
+ 	u32 version;
+ 	bool requires_force_stop;
++	const char *m3_firmware_name;
+ 
+ 	struct qcom_rproc_glink glink_subdev;
+ 	struct qcom_rproc_pdm pdm_subdev;
+@@ -934,11 +936,41 @@
+ 	return wcss->mem_region + offset;
+ }
+ 
++static int q6v5_wcss_load_aux(struct q6v5_wcss *wcss, const char *fw_name)
++{
++	const struct firmware *extra_fw;
++	int ret;
++
++	dev_info(wcss->dev, "loading additional firmware image %s\n", fw_name);
++
++	ret = request_firmware(&extra_fw, fw_name, wcss->dev);
++	if (ret)
++		return ret;
++
++	ret = qcom_mdt_load_no_init(wcss->dev, extra_fw, fw_name,
++				    wcss->mem_region, wcss->mem_phys,
++				    wcss->mem_size, &wcss->mem_reloc);
++
++	release_firmware(extra_fw);
++
++	if (ret)
++		dev_err(wcss->dev, "can't load %s\n", fw_name);
++
