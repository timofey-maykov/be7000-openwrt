Date: Tue, 29 Sep 2026 21:53:17 +0000
Subject: [PATCH 4/5] mac80211: drop ath11k 951 and ath12k 307, both are in
 backports 7.2

---
 ...1k-use-iommu-paging-domain-allocator.patch | 19 -------------------
 ...2k-avoid-duplicate-soc-debugfs-files.patch | 18 ------------------
 2 files changed, 37 deletions(-)
 delete mode 100644 package/kernel/mac80211/patches/ath11k/951-wifi-ath11k-use-iommu-paging-domain-allocator.patch
 delete mode 100644 package/kernel/mac80211/patches/ath12k/307-wifi-ath12k-avoid-duplicate-soc-debugfs-files.patch

diff --git a/package/kernel/mac80211/patches/ath11k/951-wifi-ath11k-use-iommu-paging-domain-allocator.patch b/package/kernel/mac80211/patches/ath11k/951-wifi-ath11k-use-iommu-paging-domain-allocator.patch
deleted file mode 100644
index 6f55f80284..0000000000
--- a/package/kernel/mac80211/patches/ath11k/951-wifi-ath11k-use-iommu-paging-domain-allocator.patch
+++ /dev/null
@@ -1,19 +0,0 @@
-Subject: wifi: ath11k: use IOMMU paging domain allocator
-
-Linux 6.18 no longer exposes iommu_domain_alloc(). Use the current
-iommu_paging_domain_alloc() helper when ath11k AHB creates the firmware
-IOMMU domain.
-
-Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
----
---- a/drivers/net/wireless/ath/ath11k/ahb.c
-+++ b/drivers/net/wireless/ath/ath11k/ahb.c
-@@ -1063,7 +1063,7 @@ static int ath11k_ahb_fw_resources_init(
- 
- 	ab_ahb->fw.dev = &pdev->dev;
- 
--	iommu_dom = iommu_domain_alloc(&platform_bus_type);
-+	iommu_dom = iommu_paging_domain_alloc(ab_ahb->fw.dev);
- 	if (!iommu_dom) {
- 		ath11k_err(ab, "failed to allocate iommu domain\n");
- 		ret = -ENOMEM;
diff --git a/package/kernel/mac80211/patches/ath12k/307-wifi-ath12k-avoid-duplicate-soc-debugfs-files.patch b/package/kernel/mac80211/patches/ath12k/307-wifi-ath12k-avoid-duplicate-soc-debugfs-files.patch
deleted file mode 100644
index db683f5d8c..0000000000
--- a/package/kernel/mac80211/patches/ath12k/307-wifi-ath12k-avoid-duplicate-soc-debugfs-files.patch
+++ /dev/null
@@ -1,18 +0,0 @@
-Subject: wifi: ath12k: avoid duplicate SoC debugfs files
-
-ath12k_core_start() already creates the SoC-level debugfs files after
-powering up the device. Do not create the same files again from
-ath12k_mac_allocate(), otherwise debugfs reports duplicate entries such
-as "simulate_fw_crash" and "device_dp_stats".
-
-Signed-off-by: Igor Kravchenko <igor.kravchenko05@gmail.com>
----
---- a/drivers/net/wireless/ath/ath12k/mac.c
-+++ b/drivers/net/wireless/ath/ath12k/mac.c
-@@ -14387,7 +14387,6 @@ static int ath12k_mac_allocate(struct at
- 			continue;
- 
--		ath12k_debugfs_pdev_create(ab);
- 		ath12k_mac_set_device_defaults(ab);
- 		total_radio += ab->num_radios;
- 	}
-- 
2.39.5

