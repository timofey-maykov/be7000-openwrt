+// Recover pending confirmation after a new login, without disclosing the token.
+function uci_pending_authenticated() {
+	if (type(ctx.authsession) != 'string' || type(ctx.authuser) != 'string' ||
+	    !ubus.call('session', 'access', {
+		ubus_rpc_session: ctx.authsession,
+		scope: 'ubus', object: 'uci', function: 'apply'
+	    })?.access) {
+		last_ubus_error = STATUS_PERMISSION_DENIED;
+		return null;
+	}
+
+	const data = ubus.call('session', 'get', {
+		ubus_rpc_session: '00000000000000000000000000000000',
+		keys: [ 'rollback' ]
+	})?.values?.rollback;
+
+	if (type(data?.token) != 'string' || type(data?.session) != 'string' ||
+	    type(data?.id) != 'string' || type(data?.timeout) != 'int' || data.timeout <= time()) {
+		last_ubus_error = STATUS_NO_DATA;
+		return null;
+	}
+	if (data.username != ctx.authuser) {
+		last_ubus_error = STATUS_PERMISSION_DENIED;
+		return null;
+	}
+	return data;
+}
+
 return {
