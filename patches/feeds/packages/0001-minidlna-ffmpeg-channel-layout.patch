+Subject: [PATCH] minidlna: use AVChannelLayout with FFmpeg 5.1 and later
+
+FFmpeg 7 removed AVCodecParameters.channels. Read the channel count from
+ch_layout on versions that provide it, keeping compatibility with older
+FFmpeg releases. This is required by the pinned FFmpeg 9 package.
+---
+--- a/libav.h
++++ b/libav.h
+@@ -174,7 +174,11 @@
+ #define lav_codec_tag(s) s->codecpar->codec_tag
+ #define lav_sample_rate(s) s->codecpar->sample_rate
+ #define lav_bit_rate(s) s->codecpar->bit_rate
++#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(59, 24, 100)
++#define lav_channels(s) s->codecpar->ch_layout.nb_channels
++#else
+ #define lav_channels(s) s->codecpar->channels
++#endif
+ #define lav_width(s) s->codecpar->width
+ #define lav_height(s) s->codecpar->height
+ #define lav_profile(s) s->codecpar->profile
