Subject: [PATCH] roamd: bring roamd to a Beam WRT node from the controller

A Beam WRT node (aarch64_cortex-a73) has no package in the roamd
release feed, so the capture fell back to "apk update && apk add
install roamd" on the node. That command was wrong for apk ("install"
is not a package name), "update" fails as soon as one feed is
unreachable, and the node usually has no internet of its own while it
is being captured. The capture stopped with "no package for this
OpenWrt version and no feed access".

When the node is aarch64_cortex-a73 and uses apk, the controller now
fetches roamd, luci-app-roamd and luci-i18n-roamd-ru from its own feed
and pushes them like a cached package. If that is not possible the old
fallback runs, now as "apk add roamd" and without stopping on a failed
update. The version goes to 1.2.0_p1 so installed controllers pick the
fixed package up.
---
--- a/package/roamd/Makefile
+++ b/package/roamd/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=roamd
-PKG_VERSION:=1.2.0-r2
+PKG_VERSION:=1.2.0_p1-r2
 PKG_RELEASE:=
 
 PKG_LICENSE:=Apache-2.0
--- a/package/roamd/src/mesh_node_pkg.c
+++ b/package/roamd/src/mesh_node_pkg.c
@@ -103,6 +103,68 @@
 	return 1;
 }
 
+/*
+ * Beam WRT (Xiaomi BE7000, the only aarch64_cortex-a73 build) has no
+ * package in the roamd release feed. When the controller is Beam WRT too, it
+ * fetches roamd from its own signed feed and pushes it like a cached package,
+ * so the node needs no internet of its own during the capture.
+ * Returns -1 when the packages could not be fetched here.
+ */
+#define BEAM_PKG_DIR	"/tmp/roamd-beam-pkg"
+
+static int beam_node_install(const char *addr, bool force)
+{
+	static const char *const names[] = { MESH_PKG_MAIN, MESH_PKG_UI, MESH_PKG_I18N };
+	bool luci = node_has_luci(addr);
+	char cmd[512], path[256];
+	FILE *fp;
+	size_t i;
+	int try;
+
+	snprintf(cmd, sizeof(cmd),
+		 "rm -rf " BEAM_PKG_DIR " && mkdir -p " BEAM_PKG_DIR " && cd " BEAM_PKG_DIR
+		 " && apk fetch %s %s %s >/dev/null 2>&1; ls " BEAM_PKG_DIR "/%s-[0-9]*.apk",
+		 names[0], names[1], names[2], names[0]);
+	if (system(cmd))
+		return -1;
+
+	for (i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		bool main_pkg = !strcmp(names[i], MESH_PKG_MAIN);
+
+		if (!main_pkg && !luci)
+			continue;
+
+		snprintf(cmd, sizeof(cmd), "ls " BEAM_PKG_DIR "/%s-[0-9]*.apk 2>/dev/null | head -n 1",
+			 names[i]);
+		fp = popen(cmd, "r");
+		if (!fp)
+			return -1;
+		path[0] = 0;
+		if (!fgets(path, sizeof(path), fp))
+			path[0] = 0;
+		pclose(fp);
+		path[strcspn(path, "\r\n")] = 0;
+
+		if (!path[0]) {
+			if (main_pkg)
+				return -1;
+			continue;
+		}
+
+		if (pkg_push(addr, path, true, force) && main_pkg)
+			return MESH_NODE_INSTALL_FAILED;
+	}
+
+	for (try = 0; try < 5; try++) {
+		if (!mesh_ssh(addr, "command -v roamd >/dev/null", NULL, 0, NODE_SSH_SHORT))
+			return 0;
+
+		sleep(5);
+	}
+
+	return MESH_NODE_INSTALL_FAILED;
+}
+
 int mesh_node_install(const char *addr, const char *branch, const char *arch, bool force)
 {
 	char path[256];
@@ -114,6 +176,13 @@
 
 	mesh_ssh(addr, ": > /tmp/roamd-install.log", NULL, 0, NODE_SSH_SHORT);
 
+	if (!strcmp(arch, "aarch64_cortex-a73") && apk) {
+		int rc = beam_node_install(addr, force);
+
+		if (rc >= 0)
+			return rc;
+	}
+
 	for (i = 0; i < MESH_PKG_COUNT; i++) {
 		bool main_pkg = !strcmp(mesh_pkg_names[i], MESH_PKG_MAIN);
 
@@ -149,9 +218,11 @@
 		{
 			char cmd[512];
 
-			snprintf(cmd, sizeof(cmd), "%s; pkg_run %s update >/dev/null 2>&1 && "
-				 "pkg_run %s install roamd >/dev/null 2>&1", pkg_lock,
-				 apk ? "apk" : "opkg", apk ? "apk add" : "opkg");
+			/* one unreachable feed makes "update" fail, the rest still works;
+			 * apk installs with "apk add roamd", not "apk add install roamd" */
+			snprintf(cmd, sizeof(cmd), "%s; pkg_run %s update >/dev/null 2>&1; "
+				 "pkg_run %s roamd >/dev/null 2>&1", pkg_lock,
+				 apk ? "apk" : "opkg", apk ? "apk add" : "opkg install");
 
 			if (mesh_ssh(addr, cmd, NULL, 0, NODE_SSH_LONG))
 				return MESH_NODE_NO_PACKAGE;
