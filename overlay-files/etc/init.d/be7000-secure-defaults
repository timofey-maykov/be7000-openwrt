#!/bin/sh /etc/rc.common
# Radios stay disabled until the user configures Wi-Fi (the port creates an open AP by default).
START=99
boot() {
	[ -e /etc/.be7000_secure_defaults ] && return 0
	(
		i=0
		while [ $i -lt 120 ]; do
			uci -q get wireless.radio0 >/dev/null && uci -q get wireless.radio1 >/dev/null && break
			i=$((i+1)); sleep 1
		done
		for r in 0 1; do
			uci -q get wireless.radio$r >/dev/null || continue
			uci -q set wireless.radio$r.disabled=1
			uci -q set wireless.default_radio$r.disabled=1
		done
		uci commit wireless
		touch /etc/.be7000_secure_defaults
		wifi reload
	) &
}
