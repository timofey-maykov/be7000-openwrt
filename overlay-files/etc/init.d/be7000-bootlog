#!/bin/sh /etc/rc.common
# Second and final copy of the boot log into crash_syslog, taken when the
# system is up. See /lib/preinit/02_be7000_bootlog for why and how to read it.
START=98

start() {
	grep -q '"crash_syslog"' /proc/mtd || return 0
	{
		echo "=== be7000 bootlog: boot done $(cut -d' ' -f1 /proc/uptime)s ==="
		cat /proc/cmdline
		dmesg | head -c 45000
		echo "=== ip addr ==="
		ip addr 2>&1
		echo "=== board.json ==="
		ls -la /etc/board.json 2>&1
		echo "=== uci network ==="
		uci -q export network 2>&1
		echo "=== overlay ==="
		grep -E ' /overlay | / ' /proc/mounts
		echo "=== logread ==="
		logread 2>/dev/null | tail -n 80
	} 2>&1 | head -c 63000 > /tmp/be7000-bootlog.txt
	mtd -q -e crash_syslog write /tmp/be7000-bootlog.txt crash_syslog >/dev/null 2>&1
}
