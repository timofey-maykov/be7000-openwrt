# The lvm2 package's hotplug hook, but not for the flash partitions. Every
# mtdblock and ubiblock of the BE7000 comes through here at boot, about 30
# of them, and each lvm run took ~0.4 s and found nothing: LVM never lives
# on the raw flash. Disks (USB, sd*) are handled as before.

[ "$ACTION" = "add" ] || return 0
case "$DEVNAME" in mtdblock*|ubiblock*) return 0 ;; esac
[ -e "/dev/$DEVNAME" ] || return 0

/sbin/lvm vgscan --mknodes --devices /dev/$DEVNAME || :
/sbin/lvm vgchange -aly --devices /dev/$DEVNAME || :
