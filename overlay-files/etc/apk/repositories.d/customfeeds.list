# Packages built from the same tree as this firmware, for aarch64_cortex-a73.
#
# The official mirror builds qualcommbe as aarch64_cortex-a53, so its generic
# feeds return 404 here and nothing can be installed from them. These indexes
# are signed with the key the image already trusts.
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/base/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/packages/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/luci/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/awg/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/awgproto/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/beamextras/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/byedpi/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/netshift/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/roamd/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/zapret/packages.adb
https://timofey-maykov.github.io/be7000-openwrt/feed/aarch64_cortex-a73/zapret2/packages.adb

# hybrid-failover, rebuilt from every new upstream release
https://timofey-maykov.github.io/be7000-openwrt/feed/hybrid-failover/aarch64_cortex-a73/packages.adb

# LuCI pages and scripts that need no compiler, published on every change
https://timofey-maykov.github.io/be7000-openwrt/feed/extra/aarch64_cortex-a73/packages.adb

# Kernel modules built against the kernel this firmware ships. The mirror's
# own target feed is built against a newer kernel and cannot satisfy the
# dependency, so the modules have to come from here.
https://timofey-maykov.github.io/be7000-openwrt/feed/targets/qualcommbe/ipq95xx/packages/packages.adb
