# The spare firmware slot given over to /overlay (System, Slots, see
# /usr/libexec/be7000-slots): attach it as ubi2 before mount_root, so that
# fstools finds the /dev/ubi2_0 named in fstab and mounts /overlay there.
#
# The bootloader variable be7000_slot_storage names the mtd. The image has no
# /etc/fw_env.config this early (be7000_boot_success writes it later), so the
# variable is read through a config of our own.

be7000_slot_storage() {
	local env name num a cfg=/tmp/be7000-fwenv.config
	env=$(grep -i '"0:appsblenv"' /proc/mtd | cut -d: -f1)
	[ -n "$env" ] || return 0
	mkdir -p /var/lock
	echo "/dev/$env 0x0 0x10000 0x20000" > $cfg
	name=$(fw_printenv -c $cfg -n be7000_slot_storage 2>/dev/null)
	rm -f $cfg
	case "$name" in rootfs|rootfs_1) ;; *) return 0 ;; esac
	# never the slot this system runs from
	for a in $(cat /proc/cmdline); do
		[ "$a" = "ubi.mtd=$name" ] && return 0
	done
	num=$(grep "\"$name\"" /proc/mtd | cut -d: -f1 | tr -dc '0-9')
	[ -n "$num" ] || return 0
	[ -d /sys/class/ubi/ubi2 ] && return 0
	ubiattach -m "$num" -d 2 >/dev/null 2>&1 ||
		echo "- be7000: could not attach $name, /overlay stays where it was -"
}

[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_main be7000_slot_storage
