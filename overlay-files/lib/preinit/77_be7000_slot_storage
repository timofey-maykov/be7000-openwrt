# /overlay on the spare firmware slot and the data partition glued together
# (System, Slots, see /usr/libexec/be7000-slots).
#
# The kernel module be7000-mtdconcat glues the spare slot and mtd "overlay"
# into one MTD device, be7000_concat, and one UBI device (ubi2) spans it.
# fstab, in the slot's own rootfs_data, points /overlay at /dev/ubi2_0. This
# runs before mount_root.
#
# Bootloader variables (the image has no /etc/fw_env.config this early, so
# they are read through a config of our own):
#   be7000_slot_storage     "<slot mtd>+overlay" while the mode is on
#   be7000_slot_storage_op  set from the Slots page, done here once:
#     "enable <slot mtd> <cfg|rootfs_data>"  copy /overlay (from the data
#        partition or from rootfs_data) to RAM, glue, format, copy it back
#     "disable"  copy /overlay to RAM, unglue, format the data partition as
#        the stock "cfg" volume again, copy it back, wipe the spare slot
#
# The moving is done here because the data partition cannot be detached or
# formatted while /overlay is mounted from it. Whatever fails, /overlay ends
# up on a working volume with the data on it: the steps that can fail before
# anything is erased undo themselves, and after an erase the RAM copy goes
# back onto the data partition.

S=/tmp/be7000-s77
FWCFG=/tmp/be7000-fwenv.config
VOL=be7000_storage
CONCAT=be7000_concat

s77_log() {
	echo "- be7000 slot storage: $* -"
	echo "be7000 slot storage: $*" > /dev/kmsg 2>/dev/null
}

s77_fw() {
	local env
	env=$(grep -i '"0:appsblenv"' /proc/mtd | cut -d: -f1)
	[ -n "$env" ] || return 1
	mkdir -p /var/lock
	echo "/dev/$env 0x0 0x10000 0x20000" > $FWCFG
}
s77_get() { fw_printenv -c $FWCFG -n "$1" 2>/dev/null; }
s77_set() { fw_setenv -c $FWCFG "$1" $2 2>/dev/null; }

s77_mtdnum() { grep "\"$1\"" /proc/mtd | cut -d: -f1 | tr -dc '0-9'; }

# /dev nodes of a UBI device and its volumes: hotplug makes them later, but
# ubimkvol, mount and fstools need them right away in preinit
s77_nodes() {
	local d n
	for d in /sys/class/ubi/$1 /sys/class/ubi/$1_*; do
		[ -e "$d/dev" ] || continue
		n=/dev/$(basename "$d")
		[ -c "$n" ] || mknod "$n" c $(tr ':' ' ' < "$d/dev")
	done
}

# the device of a UBI volume by name, on one ubi device
s77_vol() {
	local n
	for n in /sys/class/ubi/$1_*/name; do
		[ -e "$n" ] || continue
		case " $2 " in *" $(cat "$n") "*) echo "/dev/$(basename "$(dirname "$n")")"; return 0 ;; esac
	done
	return 1
}

# uci batch (stdin) on fstab in the slot's own rootfs_data, which fstools reads
s77_rd_fstab() {
	local dev rc=0
	dev=$(s77_vol ubi0 rootfs_data) || return 1
	mkdir -p $S/rd
	mount -t ubifs "$dev" $S/rd || return 1
	mkdir -p $S/rd/upper/etc/config
	[ -f $S/rd/upper/etc/config/fstab ] || cp /etc/config/fstab $S/rd/upper/etc/config/fstab 2>/dev/null || : > $S/rd/upper/etc/config/fstab
	uci -q -c $S/rd/upper/etc/config batch || rc=1
	sync
	umount $S/rd
	return $rc
}

s77_fstab_bigoverlay() {
	s77_rd_fstab <<-EOT
		delete fstab.slotstorage
		set fstab.bigoverlay=mount
		set fstab.bigoverlay.target='/overlay'
		set fstab.bigoverlay.device='/dev/ubi1_1'
		set fstab.bigoverlay.fstype='ubifs'
		set fstab.bigoverlay.options='rw,noatime'
		set fstab.bigoverlay.enabled='1'
		commit fstab
	EOT
}

s77_fstab_slotstorage() {
	s77_rd_fstab <<-EOT
		set fstab.slotstorage=mount
		set fstab.slotstorage.target='/overlay'
		set fstab.slotstorage.device='/dev/ubi2_0'
		set fstab.slotstorage.fstype='ubifs'
		set fstab.slotstorage.options='rw,noatime'
		set fstab.slotstorage.enabled='1'
		set fstab.bigoverlay=mount
		set fstab.bigoverlay.enabled='0'
		commit fstab
	EOT
}

# A sysupgrade normally preserves /etc/config/fstab, but do not leave the
# glued volume unused if that named section is missing or damaged. Read the
# new slot's rootfs_data without changing it first; only rewrite the file when
# every value fstools needs is not already there.
s77_slotstorage_fstab_ok() {
	local c="$1" big
	[ -f "$c/fstab" ] || return 1
	[ "$(uci -q -c "$c" get fstab.slotstorage)" = mount ] || return 1
	[ "$(uci -q -c "$c" get fstab.slotstorage.target)" = /overlay ] || return 1
	[ "$(uci -q -c "$c" get fstab.slotstorage.device)" = /dev/ubi2_0 ] || return 1
	[ "$(uci -q -c "$c" get fstab.slotstorage.fstype)" = ubifs ] || return 1
	[ "$(uci -q -c "$c" get fstab.slotstorage.options)" = rw,noatime ] || return 1
	[ "$(uci -q -c "$c" get fstab.slotstorage.enabled)" = 1 ] || return 1
	big=$(uci -q -c "$c" get fstab.bigoverlay.enabled)
	[ -z "$big" ] || [ "$big" = 0 ]
}

s77_ensure_slotstorage_fstab() {
	local dev c
	# The bootloader flag alone is not enough to write a mount entry: verify
	# that the expected named volume is really attached at the expected node.
	[ "$(s77_vol ubi2 "$VOL")" = /dev/ubi2_0 ] || return 1
	dev=$(s77_vol ubi0 rootfs_data) || return 1
	mkdir -p "$S/rd"
	mount -t ubifs -o ro "$dev" "$S/rd" || return 1
	c="$S/rd/upper/etc/config"
	if s77_slotstorage_fstab_ok "$c"; then
		umount "$S/rd"
		return $?
	fi
	umount "$S/rd" || return 1
	if s77_fstab_slotstorage; then
		s77_log "restored the missing or damaged fstab entry for /dev/ubi2_0"
		return 0
	fi
	return 1
}

s77_prepare_slotstorage_fstab() {
	s77_ensure_slotstorage_fstab && return 0
	s77_log "could not verify or restore the fstab entry for slot storage, /overlay falls back to rootfs_data"
	if ! s77_concat_down; then
		s77_log "could not detach the unusable slot storage volume"
	fi
	# A damaged or unavailable glued volume must never stop mount_root from
	# using the current slot's rootfs_data as its safe fallback.
	return 0
}

# glue <slot mtd> and the data partition, attach the result as ubi2
s77_concat_up() {
	local num
	grep -q "\"$CONCAT\"" /proc/mtd || insmod be7000-mtdconcat parts="$1,overlay" name=$CONCAT || return 1
	num=$(s77_mtdnum $CONCAT)
	[ -n "$num" ] || return 1
	# the node of the new MTD device, hotplug makes it only later
	[ -c /dev/mtd$num ] || mknod /dev/mtd$num c $(tr ':' ' ' < /sys/class/mtd/mtd$num/dev) 2>/dev/null
	[ -c /dev/mtd$num ] || return 1
	echo "$num"
}

s77_concat_down() {
	[ -d /sys/class/ubi/ubi2 ] && { ubidetach -d 2 >/dev/null 2>&1 || return 1; }
	grep -q "\"$CONCAT\"" /proc/mtd && { rmmod be7000-mtdconcat || return 1; }
	return 0
}

# copy upper/ of a volume into RAM
s77_save() {
	rm -rf $S/up $S/src
	mkdir -p $S/up $S/src
	mount -t ubifs -o ro "$1" $S/src || return 1
	if [ -d $S/src/upper ]; then
		cp -a $S/src/upper/. $S/up/ || { umount $S/src; return 1; }
	fi
	umount $S/src
}

# the settings inside an upper/ directory, back to /overlay on the data partition
s77_upper_bigoverlay() {
	mkdir -p "$1/etc/config"
	uci -q -c "$1/etc/config" batch <<-EOT
		delete fstab.slotstorage
		set fstab.bigoverlay=mount
		set fstab.bigoverlay.target='/overlay'
		set fstab.bigoverlay.device='/dev/ubi1_1'
		set fstab.bigoverlay.fstype='ubifs'
		set fstab.bigoverlay.options='rw,noatime'
		set fstab.bigoverlay.enabled='1'
		commit fstab
	EOT
	[ -f "$1/etc/config/bigoverlay" ] && uci -q -c "$1/etc/config" batch <<-EOT
		set bigoverlay.main.enabled='1'
		commit bigoverlay
	EOT
	return 0
}

# an enable that stopped before anything was erased: /overlay stays where it
# was, only the settings made for the move are taken back
s77_enable_undo() {
	local src="$1" dev
	if [ "$src" = cfg ]; then
		s77_fstab_bigoverlay
		dev=$(s77_vol ubi1 "cfg overlay_data") && mkdir -p $S/dst && mount -t ubifs "$dev" $S/dst && {
			s77_upper_bigoverlay $S/dst/upper
			sync
			umount $S/dst
		}
	else
		s77_rd_fstab <<-EOT
			delete fstab.slotstorage
			commit fstab
		EOT
	fi
	s77_set be7000_slot_storage_op
}

# put the RAM copy onto the data partition as the stock "cfg" volume (id 1,
# like stock creates it) and leave it attached as ubi1 for mount_root
s77_to_cfg() {
	local num
	num=$(s77_mtdnum overlay)
	[ -n "$num" ] || return 1
	s77_upper_bigoverlay $S/up
	[ -d /sys/class/ubi/ubi1 ] && ubidetach -d 1 >/dev/null 2>&1
	ubiformat "/dev/mtd$num" -y -q || return 1
	ubiattach -m "$num" -d 1 >/dev/null || return 1
	s77_nodes ubi1
	ubimkvol /dev/ubi1 -n 1 -N cfg -m >/dev/null || return 1
	s77_nodes ubi1
	mkdir -p $S/dst
	mount -t ubifs /dev/ubi1_1 $S/dst || return 1
	mkdir -p $S/dst/upper $S/dst/work
	cp -a $S/up/. $S/dst/upper/ || { umount $S/dst; return 1; }
	: > $S/dst/.bigoverlay_migrated
	sync
	umount $S/dst
	# stock's own settings on that partition are gone, it makes new ones
	s77_set flag_format_overlay 1
}

s77_enable() {
	local slot="$1" src="$2" dev num
	case "$src" in
	cfg) dev=$(s77_vol ubi1 "cfg overlay_data") ;;
	rootfs_data) dev=$(s77_vol ubi0 rootfs_data) ;;
	esac
	if [ -z "$dev" ] || ! s77_save "$dev"; then
		s77_log "could not read /overlay from $src, nothing changed"
		s77_enable_undo "$src"
		return 1
	fi
	if [ "$src" = cfg ] && ! ubidetach -d 1 >/dev/null 2>&1; then
		s77_log "could not detach the data partition, nothing changed"
		s77_enable_undo "$src"
		return 1
	fi
	num=$(s77_concat_up "$slot")
	if [ -z "$num" ]; then
		s77_log "could not glue $slot and the data partition, nothing changed"
		s77_concat_down
		[ "$src" = cfg ] && { ubiattach -m "$(s77_mtdnum overlay)" -d 1 >/dev/null 2>&1; s77_nodes ubi1; }
		s77_enable_undo "$src"
		return 1
	fi
	# from here on the data partition gets erased
	if ubiformat "/dev/mtd$num" -y -q && ubiattach -m "$num" -d 2 >/dev/null && s77_nodes ubi2 &&
	   ubimkvol /dev/ubi2 -N $VOL -m >/dev/null && s77_nodes ubi2 && mkdir -p $S/dst &&
	   mount -t ubifs /dev/ubi2_0 $S/dst; then
		mkdir -p $S/dst/upper $S/dst/work
		if cp -a $S/up/. $S/dst/upper/; then
			: > $S/dst/.be7000_slotstorage_ready
			sync
			umount $S/dst
			s77_set be7000_slot_storage "$slot+overlay"
			s77_set be7000_slot_storage_op
			s77_log "/overlay is on $slot and the data partition now"
			rm -rf $S
			return 0
		fi
		umount $S/dst
	fi
	s77_log "formatting or copying failed, putting /overlay back on the data partition"
	s77_concat_down
	s77_to_cfg && s77_fstab_bigoverlay
	s77_set be7000_slot_storage
	s77_set be7000_slot_storage_op
	rm -rf $S
	return 1
}

s77_disable() {
	local slot="$1" num
	num=$(s77_concat_up "$slot")
	[ -n "$num" ] && { [ -d /sys/class/ubi/ubi2 ] || ubiattach -m "$num" -d 2 >/dev/null; s77_nodes ubi2; }
	if [ -z "$num" ] || ! s77_save /dev/ubi2_0 || ! s77_concat_down; then
		s77_log "could not read /overlay from the glued volume, it stays there"
		s77_fstab_slotstorage
		s77_set be7000_slot_storage_op
		[ -d /sys/class/ubi/ubi2 ] || { num=$(s77_concat_up "$slot") && ubiattach -m "$num" -d 2 >/dev/null; }
		s77_nodes ubi2
		return 1
	fi
	if ! s77_to_cfg; then
		s77_log "could not write /overlay to the data partition"
		s77_set be7000_slot_storage_op
		return 1
	fi
	# the spare slot holds nothing now: an empty UBI, ready for a firmware
	ubiformat "/dev/mtd$(s77_mtdnum "$slot")" -y -q
	s77_set be7000_slot_storage
	s77_set be7000_slot_storage_op
	s77_log "/overlay is back on the data partition, $slot is empty"
	rm -rf $S
}

be7000_slot_storage() {
	local cur="" a val op slot num
	for a in $(cat /proc/cmdline); do
		case "$a" in ubi.mtd=rootfs|ubi.mtd=rootfs_1) cur=${a#ubi.mtd=} ;; esac
	done
	[ -n "$cur" ] || return 0
	s77_fw || return 0
	val=$(s77_get be7000_slot_storage)
	op=$(s77_get be7000_slot_storage_op)
	mkdir -p $S

	set -- $op
	case "$1" in
	enable)
		[ -z "$val" ] && [ "$2" != "$cur" ] && case "$2" in rootfs|rootfs_1) s77_enable "$2" "$3" ;; esac
		s77_set be7000_slot_storage_op
		;;
	disable)
		[ -n "$val" ] && s77_disable "${val%%+*}"
		s77_set be7000_slot_storage_op
		;;
	*)
		slot=${val%%+*}
		case "$slot" in rootfs|rootfs_1) ;; *) rm -f $FWCFG; return 0 ;; esac
		# never the slot this system runs from
		[ "$slot" = "$cur" ] && { rm -f $FWCFG; return 0; }
		num=$(s77_concat_up "$slot")
		if [ -z "$num" ] || ! ubiattach -m "$num" -d 2 >/dev/null 2>&1; then
			s77_log "could not attach $slot with the data partition, /overlay falls back to rootfs_data"
		else
			s77_nodes ubi2
			s77_prepare_slotstorage_fstab
		fi
		;;
	esac
	rm -f $FWCFG
}

[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_main be7000_slot_storage
