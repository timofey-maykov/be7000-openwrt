# Start without USB when the previous boot did not finish.
#
# The bootloader adds one to flag_try_sys{N}_failed on every boot of a slot,
# and only be7000-bootconfirm, at the very end of boot, sets it back to zero.
# Past five it gives up and starts the other slot, which is stock for most
# people. A dying USB disk with extroot on it gets there by itself: mounting
# it or reading from it hangs or crashes every boot before the end, and after
# the sixth power cycle the router is on stock with no hint why. Seen on a
# BE7000 whose flash drive died under extroot.
#
# So when the counter of this slot is 2 or more, the last boot did not reach
# bootconfirm and USB is switched off here, before mount_root. block extroot
# does not find the disk, waits delay_root and goes on with the built-in
# overlay. The router comes up reachable, without the packages from the
# disk, bootconfirm zeroes the counter and the next boot tries USB again.

EG_FWCFG=/tmp/be7000-eg-fwenv.config

be7000_extroot_guard() {
	local arg var n env dev i
	for arg in $(cat /proc/cmdline); do
		case "$arg" in
		ubi.mtd=rootfs)   var=flag_try_sys1_failed ;;
		ubi.mtd=rootfs_1) var=flag_try_sys2_failed ;;
		esac
	done
	[ -n "$var" ] || return 0
	# no /etc/fw_env.config this early, see 77_be7000_slot_storage
	env=$(grep -i '"0:appsblenv"' /proc/mtd | cut -d: -f1)
	[ -n "$env" ] || return 0
	mkdir -p /var/lock
	echo "/dev/$env 0x0 0x10000 0x20000" > $EG_FWCFG
	n=$(fw_printenv -c $EG_FWCFG -n "$var" 2>/dev/null)
	rm -f $EG_FWCFG
	case "$n" in ''|*[!0-9]*) return 0 ;; esac
	[ "$n" -ge 2 ] || return 0

	echo "- be7000: the previous boot did not finish ($var=$n), starting without USB -"
	echo "be7000: the previous boot did not finish ($var=$n), USB is off until the next boot" > /dev/kmsg 2>/dev/null
	# A disk stuck in error handling can hold the unbind up, so it runs on
	# its own and preinit only waits for the disks to go away.
	for dev in /sys/bus/platform/drivers/xhci-hcd/xhci-hcd.*; do
		[ -e "$dev" ] || continue
		( echo "${dev##*/}" > /sys/bus/platform/drivers/xhci-hcd/unbind ) 2>/dev/null &
	done
	i=0
	while [ $i -lt 10 ] && ls -d /sys/block/sd* >/dev/null 2>&1; do
		sleep 1
		i=$((i + 1))
	done
}

[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_main be7000_extroot_guard
