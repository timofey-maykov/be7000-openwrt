#!/bin/sh
# Save the kernel log into the crash_syslog partition as early as userspace
# allows, so a board that never gets as far as the network can still be
# diagnosed: boot stock afterwards and read it back with
#   dd if=/dev/mtd27 bs=64k 2>/dev/null | strings
# (crash_syslog is mtd27 on both stock and this image). A later copy from
# /etc/init.d/be7000-bootlog overwrites it with the full log once boot is done,
# so whatever is in there is the furthest the last boot got. Kernel panics go
# to the neighbouring "crash" partition through mtdoops, see the bootargs.

be7000_bootlog_early() {
	local part
	part=$(grep '"crash_syslog"' /proc/mtd | cut -d: -f1)
	[ -n "$part" ] || return 0
	{
		echo "=== be7000 bootlog: preinit $(cat /proc/uptime | cut -d' ' -f1)s ==="
		cat /proc/cmdline
		dmesg
	} > /tmp/be7000-bootlog.txt 2>&1
	mtd -q -e crash_syslog write /tmp/be7000-bootlog.txt crash_syslog >/dev/null 2>&1
}

boot_hook_add preinit_main be7000_bootlog_early
