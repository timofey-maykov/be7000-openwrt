#!/bin/sh
# Save the kernel log into the crash_syslog partition, so a board that never
# gets as far as the network can still be diagnosed: boot stock afterwards and
# read it back with
#   dd if=/dev/mtd27 bs=64k 2>/dev/null | strings
# (crash_syslog is mtd27 on both stock and this image).
#
# One copy is taken here, at the start of preinit, and then a background loop
# keeps rewriting it every 15 seconds for four minutes. A boot that hangs in
# preinit (a driver stuck opening a port, say) still has a live kernel, so the
# loop keeps going and the last copy shows the hung-task traces the kernel
# prints after two minutes. /etc/init.d/be7000-bootlog takes the final copy
# once boot is done. Kernel panics go to the neighbouring "crash" partition
# through mtdoops, see the bootargs.
#
# The partition is 512 KiB but the reader only needs the first 64 KiB, so
# the copy is cut there: dmesg first, then the network state. The state part
# is what tells a board that boots but does not answer on 192.168.1.1 from a
# board that never booted at all (busybox ip has no -br, plain ip is used).

be7000_bootlog_state() {
	echo "=== ip addr ==="
	ip addr 2>&1
	echo "=== board.json ==="
	ls -la /etc/board.json 2>&1
	echo "=== uci network ==="
	uci -q export network 2>&1
	echo "=== overlay ==="
	grep -E ' /overlay | / ' /proc/mounts
	echo "=== link ==="
	for i in wan lan1 lan2 lan3; do [ -x /usr/sbin/ethtool ] && ethtool $i 2>/dev/null | grep -E 'Speed|Duplex|Link detected' | tr '\n' ' '; echo " ($i)"; done
	[ -x /sbin/ip ] && ip -s link show 2>/dev/null | grep -A5 -E '^[0-9]+: (wan|lan[123]|br-lan):' | grep -E '^[0-9]+:|RX:|TX:| [0-9]+ ' | head -40
	echo "=== wireless ==="
	uci -q export wireless 2>&1 | grep -vE 'option key'
	iw dev 2>&1 | grep -E 'Interface|ssid|channel|type'
	echo "=== be7000 services ==="
	logread 2>/dev/null | grep -E 'bigoverlay|romsync|be7000-feeds|wifi-defaults|bootconfirm|AP-ENABLED|AP-DISABLED|hostapd.*(phy[01]-ap0)' | tail -n 25
	if [ -x /sbin/logread ]; then
		echo "=== logread ==="
		logread 2>/dev/null | tail -n 80
	fi
}

be7000_bootlog_write() {
	grep -q '"crash_syslog"' /proc/mtd || return 0
	{
		echo "=== be7000 bootlog: $1 $(cut -d' ' -f1 /proc/uptime)s ==="
		cat /proc/cmdline
		dmesg | head -c 45000
		be7000_bootlog_state
	} 2>&1 | head -c 63000 > /tmp/be7000-bootlog.txt
	mtd -q -e crash_syslog write /tmp/be7000-bootlog.txt crash_syslog >/dev/null 2>&1
}

be7000_bootlog_early() {
	be7000_bootlog_write preinit
	(
		i=0
		while [ $i -lt 16 ]; do
			sleep 15
			i=$((i + 1))
			be7000_bootlog_write "periodic $i"
		done
	) </dev/null >/dev/null 2>&1 &
}

boot_hook_add preinit_main be7000_bootlog_early
