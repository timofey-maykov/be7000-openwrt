{
	"luci-app-beam-modem": {
		"description": "Modem status, settings and AT console through ModemManager",
		"read": {
			"ubus": {
				"beam-modem": [ "status", "console_status" ]
			}
		},
		"write": {
			"ubus": {
				"beam-modem": [ "set_modes", "set_bands", "enable", "console_start", "console_stop", "console_send" ]
			}
		}
	}
}
