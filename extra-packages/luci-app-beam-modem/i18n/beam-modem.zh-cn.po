msgstr "会话会停止 ModemManager。会话期间调制解调器连接中断，结束后自动恢复。"

msgid "Начать сеанс"
msgstr "开始会话"

msgid " (AT)"
msgstr "（AT）"

msgid "нет портов"
msgstr "无端口"

msgid "AT-команда. Enter отправляет, ↑ ↓ листают историю"
msgstr "AT 命令。回车发送，↑ ↓ 浏览历史"

msgid "Нет портов модема"
msgstr "没有调制解调器端口"

msgid "Сначала начните сеанс"
msgstr "请先开始会话"

msgid "ждём ответ…"
msgstr "等待响应…"

