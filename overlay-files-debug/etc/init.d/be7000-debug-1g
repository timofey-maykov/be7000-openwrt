#!/bin/sh /etc/rc.common
# Debug build only: keep the LAN ports off 2.5GBASE-T. Two boards that came
# up fine but never received a single frame from the PC had their link at
# 2.5 Gbit/s; boards that work were only ever tested at 100 and 1000. Limit
# the advertised modes to 10/100/1000 so the PC negotiates 1 Gbit/s, and log
# it so the boot log shows this build did that. Delete /etc/be7000-debug-1g
# (or this service) to get 2.5G back.
START=19

start() {
	[ -e /etc/be7000-debug-1g ] || return 0
	local i
	for i in lan1 lan2 lan3; do
		[ -e /sys/class/net/$i ] || continue
		if ethtool -s $i advertise 0x02f 2>/dev/null; then
			logger -t be7000-debug "$i: advertising 10/100/1000 only (debug build)"
		else
			logger -t be7000-debug "$i: ethtool advertise failed"
		fi
	done
}
